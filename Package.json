{
  "name": "GFX.Canvas",
  "version": "0.5.0",
  "description": {
    "en": "Portable vector drawing, text, rasterization, snapshots, and mutable pixel surfaces.",
    "fr": "Dessin vectoriel portable, texte, rastérisation, instantanés et surfaces de pixels mutables."
  },
  "authors": ["Matanek"],
  "requires": { "silex": ">=0.48.0" },
  "dependencies": {
    "GFX": "^0.41.0",
    "GFX.Assets": "^0.4.0",
    "GFX.Font": "^0.2.0",
    "STD": "^0.23.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "macos-x64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "linux-arm64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "linux-x64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "windows-x64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    },
    "windows-arm64": {
      "providers": {
        "SDL3": { "requires": ["GFX.SDL3"] }
      }
    }
  }
}
