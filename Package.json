{
  "name": "GFX.Canvas",
  "version": "0.3.1",
  "description": {
    "en": "Portable vector drawing, text, rasterization, snapshots, and mutable pixel surfaces.",
    "fr": "Dessin vectoriel portable, texte, rastérisation, instantanés et surfaces de pixels mutables."
  },
  "authors": ["Matanek"],
  "requires": { "silex": ">=0.43.0" },
  "dependencies": {
    "GFX": "^0.37.0",
    "GFX.Assets": "^0.1.0",
    "STD": "^0.16.0"
  },
  "boundary": {
    "macos-arm64": {
      "providers": {
        "SDL3": {
          "requires": ["GFX.SDL3"]
        },
        "SDL3_ttf": {
          "archive": "Boundary/macos-arm64/libSDL3_ttf.a",
          "frameworks": ["CoreFoundation", "CoreGraphics", "CoreText"],
          "requires": ["GFX.SDL3"]
        }
      }
    },
    "linux-x64": {
      "providers": {
        "SDL3": {
          "requires": ["GFX.SDL3"]
        },
        "SDL3_ttf": {
          "archive": "Boundary/linux-x64/libSDL3_ttf.a",
          "libraries": ["m", "pthread"],
          "requires": ["GFX.SDL3"]
        }
      }
    },
    "windows-x64": {
      "providers": {
        "SDL3": {
          "requires": ["GFX.SDL3"]
        },
        "SDL3_ttf": {
          "archive": "Boundary/windows-x64/SDL3_ttf.lib",
          "libraries": ["gdi32", "rpcrt4", "usp10"],
          "requires": ["GFX.SDL3"]
        }
      }
    },
    "windows-arm64": {
      "providers": {
        "SDL3": {
          "requires": ["GFX.SDL3"]
        },
        "SDL3_ttf": {
          "archive": "Boundary/windows-arm64/SDL3_ttf.lib",
          "libraries": ["gdi32", "rpcrt4", "usp10"],
          "requires": ["GFX.SDL3"]
        }
      }
    }
  },
