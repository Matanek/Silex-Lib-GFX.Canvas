use Interop.C
use Interop.Boundary

module struct TextRaster {
    let width:int
    let height:int
    let alpha:str
}

public class Font {
    private static let raster_cache_capacity:int = 256
    private static var bundled_default:Font? = null
    private static var bundled_monospace:Font? = null
    private let source_path:str?
    private let encoded_data:str
    private let encoded_size:int
    private var face_sizes:float[]
    private var face_weights:int[]
    private var face_handles:uint[]
    private var raster_values:str[]
    private var raster_sizes:float[]
    private var raster_weights:int[]
    private var raster_widths:int[]
    private var raster_heights:int[]
    private var raster_alpha:str[]
    private var next_raster:int

    init(source:uint8[]) {
        if source.count() == 0 { panic("GFX.Canvas font data cannot be empty") }
        self.source_path = null
        self.encoded_data = C.string(@source[0:source.count()])
        self.encoded_size = source.count()
        self.face_sizes = []
        self.face_weights = []
        self.face_handles = []
        self.raster_values = []
        self.raster_sizes = []
        self.raster_weights = []
        self.raster_widths = []
        self.raster_heights = []
        self.raster_alpha = []
        self.next_raster = 0
    }

    init(source:str) {
        if source == "" { panic("GFX.Canvas font path cannot be empty") }
        self.source_path = source
        self.encoded_data = ""
        self.encoded_size = 0
        self.face_sizes = []
        self.face_weights = []
        self.face_handles = []
        self.raster_values = []
        self.raster_sizes = []
        self.raster_weights = []
        self.raster_widths = []
        self.raster_heights = []
        self.raster_alpha = []
        self.next_raster = 0
    }

    static func default() Font {
        if let cached = Font.bundled_default { return cached }
        var font = Font(embed_bytes("../Assets/Fonts/NotoSans.ttf"))
        Font.bundled_default = font
        return font
    }

    static func monospace() Font {
        if let cached = Font.bundled_monospace { return cached }
        var font = Font(embed_bytes("../Assets/Fonts/NotoSansMono-Regular.ttf"))
        Font.bundled_monospace = font
        return font
    }

    static func load(path:str) Font { return Font(path) }

    drop {
        for handle in self.face_handles {
            ttf_close_font(C.pointer_bits(handle))
        }
    }

    module func path() str? { return self.source_path }
    module func packed_data() str { return self.encoded_data }
    module func byte_count() int { return self.encoded_size }
    package func cached_face_count() int { return self.face_handles.count() }
    package func cached_raster_count() int { return self.raster_values.count() }

    module func cached_face(size:float, weight:int) uint? {
        var index = 0
        while index < self.face_handles.count() {
            if self.face_sizes[index] == size && self.face_weights[index] == weight {
                return self.face_handles[index]
            }
            index++
        }
        return null
    }

    module func retain_face(size:float, weight:int, handle:uint) uint? {
        var evicted:uint? = null
        if self.face_handles.count() >= 16 {
            evicted = self.face_handles[0]
            var sizes:float[] = []
            var weights:int[] = []
            var handles:uint[] = []
            var index = 1
            while index < self.face_handles.count() {
                sizes.append(self.face_sizes[index])
                weights.append(self.face_weights[index])
                handles.append(self.face_handles[index])
                index++
            }
            self.face_sizes = sizes
            self.face_weights = weights
            self.face_handles = handles
        }
        self.face_sizes.append(size)
        self.face_weights.append(weight)
        self.face_handles.append(handle)
        return evicted
    }

    module func cached_raster(
        value:str,
        size:float,
        weight:int
    ) TextRaster? {
        var index = 0
        while index < self.raster_values.count() {
            if self.raster_values[index] == value &&
                self.raster_sizes[index] == size &&
                self.raster_weights[index] == weight
            {
                return TextRaster(
                    width:self.raster_widths[index],
                    height:self.raster_heights[index],
                    alpha:self.raster_alpha[index]
                )
            }
            index++
        }
        return null
    }

    module func retain_raster(
        value:str,
        size:float,
        weight:int,
        raster:TextRaster
    ) {
        if self.raster_values.count() < Font.raster_cache_capacity {
            self.raster_values.append(value)
            self.raster_sizes.append(size)
            self.raster_weights.append(weight)
            self.raster_widths.append(raster.width)
            self.raster_heights.append(raster.height)
            self.raster_alpha.append(raster.alpha)
            return
        }
        let index = self.next_raster
        self.raster_values.replace(index, value)
        self.raster_sizes.replace(index, size)
        self.raster_weights.replace(index, weight)
        self.raster_widths.replace(index, raster.width)
        self.raster_heights.replace(index, raster.height)
        self.raster_alpha.replace(index, raster.alpha)
        self.next_raster = (index + 1) % Font.raster_cache_capacity
    }
}

let ttf_close_font = C.function<func(C.Pointer<uint8>) void>(
    library:Boundary.SDL3_ttf,
    name:"TTF_CloseFont"
)
