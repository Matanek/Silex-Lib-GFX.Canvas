use GFX.Font as VectorFont
use STD.Math
use Interop.C

module struct TextRaster {
    let width:int
    let height:int
    let alpha:str
    let offset_x:int
    let offset_y:int
}

module struct CachedTextMetrics {
    let width:float
    let height:float
    let lines:int
}

public class Font {
    private static var bundled_default:Font? = null
    private static var bundled_monospace:Font? = null
    private var face_value:VectorFont.Face
    private var instance_sizes:float[]
    private var instance_weights:int[]
    private var instance_variations:VectorFont.Variation[][]
    private var instance_values:VectorFont.Instance[]
    private var raster_instances:VectorFont.Instance[]
    private var raster_glyph_ids:uint32[]
    private var raster_densities:float[]
    private var raster_values:TextRaster[]
    private var raster_byte_counts:int[]
    private var raster_slots:int[]
    private var raster_bytes:int
    private var metric_keys:str[]
    private var metric_values:CachedTextMetrics[]
    private var next_metric_key:int

    init(source:uint8[]) {
        self.face_value = decoded_face(VectorFont.Face.decode(source))
        self.instance_sizes = []
        self.instance_weights = []
        self.instance_variations = []
        self.instance_values = []
        self.raster_instances = []
        self.raster_glyph_ids = []
        self.raster_densities = []
        self.raster_values = []
        self.raster_byte_counts = []
        self.raster_slots = empty_raster_slots()
        self.raster_bytes = 0
        self.metric_keys = []
        self.metric_values = []
        self.next_metric_key = 0
    }

    init(source:str) {
        if source == "" { panic("GFX.Canvas font path cannot be empty") }
        self.face_value = decoded_face(VectorFont.Face.open(source))
        self.instance_sizes = []
        self.instance_weights = []
        self.instance_variations = []
        self.instance_values = []
        self.raster_instances = []
        self.raster_glyph_ids = []
        self.raster_densities = []
        self.raster_values = []
        self.raster_byte_counts = []
        self.raster_slots = empty_raster_slots()
        self.raster_bytes = 0
        self.metric_keys = []
        self.metric_values = []
        self.next_metric_key = 0
    }

    init(source:VectorFont.Face) {
        self.face_value = source
        self.instance_sizes = []
        self.instance_weights = []
        self.instance_variations = []
        self.instance_values = []
        self.raster_instances = []
        self.raster_glyph_ids = []
        self.raster_densities = []
        self.raster_values = []
        self.raster_byte_counts = []
        self.raster_slots = empty_raster_slots()
        self.raster_bytes = 0
        self.metric_keys = []
        self.metric_values = []
        self.next_metric_key = 0
    }

    static func default() Font {
        if let cached = Font.bundled_default { return cached }
        var font = Font(decoded_face(VectorFont.Face.default()))
        Font.bundled_default = font
        return font
    }

    static func monospace() Font {
        if let cached = Font.bundled_monospace { return cached }
        var font = Font(decoded_face(VectorFont.Face.monospace()))
        Font.bundled_monospace = font
        return font
    }

    static func load(path:str) Font { return Font(path) }

    func face() VectorFont.Face { return self.face_value }

    module func instance(
        size:float,
        weight:int,
        variations:VectorFont.Variation[] = []
    ) VectorFont.Instance {
        var index = 0
        while index < self.instance_values.count() {
            if self.instance_sizes[index] == size &&
                self.instance_weights[index] == weight &&
                same_variations(self.instance_variations[index], variations)
            {
                return self.instance_values[index]
            }
            index++
        }

        var effective = variations
        var synthesis = VectorFont.Synthesis()
        if weight == 1 && !has_weight_variation(effective) {
            if axis = weight_axis(self.face_value) {
                var bold:float64 = 700.0
                if bold < axis.minimum { bold = axis.minimum }
                if bold > axis.maximum { bold = axis.maximum }
                effective.append(VectorFont.Variation("wght", bold))
            } else {
                synthesis = VectorFont.Synthesis(embolden:true)
            }
        }
        var created = decoded_instance(VectorFont.Instance.create(
            self.face_value,
            size:size as float64,
            variations:effective,
            synthesis:synthesis
        ))
        if self.instance_values.count() >= 32 { self.discard_oldest_instance() }
        self.instance_sizes.append(size)
        self.instance_weights.append(weight)
        self.instance_variations.append(variations)
        self.instance_values.append(created)
        return created
    }

    package func cached_face_count() int { return self.instance_values.count() }
    package func cached_raster_count() int { return self.raster_values.count() }
    package func cached_raster_byte_count() int { return self.raster_bytes }

    module func cached_metrics(key:str) CachedTextMetrics? {
        var index = 0
        while index < self.metric_keys.count() {
            if self.metric_keys[index] == key { return self.metric_values[index] }
            index++
        }
        return null
    }

    module func retain_metrics(key:str, metrics:CachedTextMetrics) {
        if self.metric_keys.count() < 512 {
            self.metric_keys.append(key)
            self.metric_values.append(metrics)
            return
        }
        self.metric_keys.replace(self.next_metric_key, key)
        self.metric_values.replace(self.next_metric_key, metrics)
        self.next_metric_key = (self.next_metric_key + 1) % 512
    }

    module func cached_raster(
        instance:VectorFont.Instance,
        glyph_id:uint32,
        density:float
    ) TextRaster? {
        let index = self.raster_slots[self.raster_slot(instance, glyph_id, density)]
        if index >= 0 {
            if self.raster_instances[index] == instance &&
                self.raster_glyph_ids[index] == glyph_id &&
                self.raster_densities[index] == density
            {
                return self.raster_values[index]
            }
        }
        return null
    }

    module func retain_raster(
        instance:VectorFont.Instance,
        glyph_id:uint32,
        density:float,
        raster:TextRaster
    ) {
        let byte_count = C.byte_count(raster.alpha) as int + 128
        if byte_count > 16_777_216 { return }
        let slot = self.raster_slot(instance, glyph_id, density)
        let index = self.raster_slots[slot]
        if index >= 0 {
            if self.raster_instances[index] == instance &&
                self.raster_glyph_ids[index] == glyph_id &&
                self.raster_densities[index] == density
            {
                return
            }
            self.discard_raster(index)
        }
        while self.raster_values.count() >= self.raster_slots.count() ||
            self.raster_bytes + byte_count > 16_777_216
        {
            self.discard_raster(0)
        }
        let retained_index = self.raster_values.count()
        self.raster_instances.append(instance)
        self.raster_glyph_ids.append(glyph_id)
        self.raster_densities.append(density)
        self.raster_values.append(raster)
        self.raster_byte_counts.append(byte_count)
        self.raster_bytes += byte_count
        self.raster_slots.replace(slot, retained_index)
    }

    private func raster_slot(
        instance:@VectorFont.Instance,
        glyph_id:uint32,
        density:float
    ) int {
        var instance_index = 0
        while instance_index < self.instance_values.count() &&
            self.instance_values[instance_index] != instance
        {
            instance_index++
        }
        let glyph_key = glyph_id as uint
        let density_key = Math.round(density * 64.0) as uint
        return ((glyph_key * 131 as uint + density_key * 17 as uint +
            instance_index as uint * 53 as uint) % self.raster_slots.count() as uint) as int
    }

    private func clear_raster_cache() {
        self.raster_instances = []
        self.raster_glyph_ids = []
        self.raster_densities = []
        self.raster_values = []
        self.raster_byte_counts = []
        self.raster_slots = empty_raster_slots()
        self.raster_bytes = 0
    }

    private func discard_raster(index:int) {
        let slot = self.raster_slot(
            self.raster_instances[index],
            self.raster_glyph_ids[index],
            self.raster_densities[index]
        )
        if self.raster_slots[slot] == index { self.raster_slots.replace(slot, -1) }
        self.raster_bytes -= self.raster_byte_counts[index]
        let last = self.raster_values.count() - 1
        if index != last {
            self.raster_instances.replace(index, self.raster_instances[last])
            self.raster_glyph_ids.replace(index, self.raster_glyph_ids[last])
            self.raster_densities.replace(index, self.raster_densities[last])
            self.raster_values.replace(index, self.raster_values[last])
            self.raster_byte_counts.replace(index, self.raster_byte_counts[last])
            let moved_slot = self.raster_slot(
                self.raster_instances[index],
                self.raster_glyph_ids[index],
                self.raster_densities[index]
            )
            if self.raster_slots[moved_slot] == last {
                self.raster_slots.replace(moved_slot, index)
            }
        }
        self.raster_instances.take_last()
        self.raster_glyph_ids.take_last()
        self.raster_densities.take_last()
        self.raster_values.take_last()
        self.raster_byte_counts.take_last()
    }

    private func discard_oldest_instance() {
        self.clear_raster_cache()
        var sizes:float[] = []
        var weights:int[] = []
        var variations:VectorFont.Variation[][] = []
        var instances:VectorFont.Instance[] = []
        var index = 1
        while index < self.instance_values.count() {
            sizes.append(self.instance_sizes[index])
            weights.append(self.instance_weights[index])
            variations.append(self.instance_variations[index])
            instances.append(self.instance_values[index])
            index++
        }
        self.instance_sizes = sizes
        self.instance_weights = weights
        self.instance_variations = variations
        self.instance_values = instances
    }
}

func decoded_face(result:Result<VectorFont.Face, VectorFont.Error>) VectorFont.Face {
    match result {
        failure(error) => { panic("GFX.Canvas could not load font: " + error.detail) }
        success(face) => { return face }
    }
}

func decoded_instance(
    result:Result<VectorFont.Instance, VectorFont.Error>
) VectorFont.Instance {
    match result {
        failure(error) => { panic("GFX.Canvas could not create font instance: " + error.detail) }
        success(instance) => { return instance }
    }
}

func same_variations(
    first:@VectorFont.Variation[],
    second:@VectorFont.Variation[]
) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        if first[index].tag != second[index].tag || first[index].value != second[index].value {
            return false
        }
        index++
    }
    return true
}

func has_weight_variation(variations:@VectorFont.Variation[]) bool {
    for variation in variations {
        if variation.tag == "wght" { return true }
    }
    return false
}

func weight_axis(face:VectorFont.Face) VectorFont.Axis? {
    for axis in face.axes() {
        if axis.tag == "wght" { return axis }
    }
    return null
}

func empty_raster_slots() int[] {
    var result:int[] = []
    while result.count() < 2_048 { result.append(-1) }
    return result
}
