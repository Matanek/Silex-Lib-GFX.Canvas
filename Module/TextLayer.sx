use GFX.Canvas.Command
use GFX.Canvas.Command.same_text_content
use GFX.Canvas.Rasterizer
use GFX.Canvas.TextRuns.text_runs
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Styles.TextAlignment
use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.Styles.TextWeight
use GFX.Canvas.Styles.same_text_style
use GFX.Canvas.Styles.same_text_variations
use GFX.Color
use GFX.Font as VectorFont
use STD.Math

public struct TextGlyphPlacement {
    let glyph:VectorFont.PlacedOutline
    let baseline:Math.Vec2
    let face_identity:str = ""
    let outline_identity:str = ""
    let embolden:bool = false
}

// Renderer-neutral shaped coverage run. Rasterization stays lazy so a renderer
// can consult its own glyph atlas before asking GFX.Font for hinted coverage.
public struct TextCoverageRun {
    var glyph_run:VectorFont.GlyphRun
    let origin:Math.Vec2
    let density:float
}

public struct TextVectorError {
    let detail:str
    let cluster:VectorFont.Cluster?
    let face_identity:str
}

// A retained text command keeps its cache identity while its content changes.
// Custom renderers can therefore update one small text texture independently.
public class TextLayer {
    private static var next_identity:int = 1
    private let current_identity:int
    private let current_revision:int
    private var current_shaping_revision:int
    private var current_command:Command? = null
    private let canvas_width:int
    private let canvas_height:int
    private var retained:Rasterizer.TextImage? = null
    private var retained_scale:float = 1.0
    private var retained_runs:VectorFont.GlyphRun[] = []
    private var retained_runs_ready:bool = false
    private var retained_offsets:Math.Vec2[] = []
    private var retained_width:float = 0.0

    module init(command:Command, width:int, height:int) {
        self.current_identity = TextLayer.next_identity
        TextLayer.next_identity++
        self.current_revision = 1
        self.current_shaping_revision = 1
        self.current_command = command
        self.canvas_width = width
        self.canvas_height = height
    }

    private init(
        command:Command,
        width:int,
        height:int,
        identity:int,
        revision:int
    ) {
        self.current_identity = identity
        self.current_revision = revision
        self.current_shaping_revision = revision
        self.current_command = command
        self.canvas_width = width
        self.canvas_height = height
    }

    module static func updated(
        command:Command,
        width:int,
        height:int,
        identity:int,
        revision:int
    ) TextLayer {
        return TextLayer(command, width, height, identity, revision)
    }

    func id() int { return self.current_identity }
    func revision() int { return self.current_revision }
    // Alternative retained renderers use this revision to keep geometry when
    // only placement or color changes.
    func shaping_revision() int { return self.current_shaping_revision }

    func color() Color {
        if let command = self.current_command {
            match command {
                text(value) => { return value.style.color }
                else => {}
            }
        }
        return Color.transparent()
    }

    func position() Math.Vec2 {
        if let command = self.current_command {
            match command {
                text(value) => { return value.position }
                else => {}
            }
        }
        return Math.Vec2()
    }

    func block_identity() int {
        if let command = self.current_command {
            match command {
                text(value) => { return value.block_identity }
                else => {}
            }
        }
        return 0
    }

    func block_revision() int {
        if let command = self.current_command {
            match command {
                text(value) => { return value.block_revision }
                else => {}
            }
        }
        return 0
    }

    func clip() Rect? {
        if let command = self.current_command {
            match command {
                text(value) => { return value.clip }
                else => {}
            }
        }
        return null
    }

    func glyph_runs() VectorFont.GlyphRun[] {
        self.ensure_runs()
        return self.retained_runs
    }

    module func ready_glyph_runs() VectorFont.GlyphRun[]? {
        if !self.retained_runs_ready { return null }
        return self.retained_runs
    }

    func glyph_run() VectorFont.GlyphRun {
        self.ensure_runs()
        if self.retained_runs.count() != 1 {
            panic("GFX.Canvas glyph_run requires one homogeneous text line; use glyph_runs for multiline or multi-face text")
        }
        return self.retained_runs[0]
    }

    func vector_outlines() Result<TextGlyphPlacement[], TextVectorError> {
        self.ensure_runs()
        let baselines = self.run_baselines()
        var result:TextGlyphPlacement[] = []
        var run_index = 0
        while run_index < self.retained_runs.count() {
            var run = self.retained_runs[run_index]
            let identity = outline_identity(run.instance())
            match run.outlines() {
                failure(error) => {
                    return Result<TextGlyphPlacement[], TextVectorError>.failure(TextVectorError(
                        detail:error.detail,
                        cluster:null,
                        face_identity:run.instance().face().identity()
                    ))
                }
                success(glyphs) => {
                    for glyph in glyphs {
                        if glyph.outline == null {
                            return Result<TextGlyphPlacement[], TextVectorError>.failure(TextVectorError(
                                detail:"font glyph $(glyph.glyph_id) has no vector outline",
                                cluster:glyph.cluster,
                                face_identity:run.instance().face().identity()
                            ))
                        }
                        result.append(TextGlyphPlacement(
                            glyph:glyph,
                            baseline:baselines[run_index],
                            face_identity:run.instance().face().identity(),
                            outline_identity:identity,
                            embolden:run.instance().synthesis().embolden
                        ))
                    }
                }
            }
            run_index++
        }
        return Result<TextGlyphPlacement[], TextVectorError>.success(result)
    }

    func coverage_runs(density:float = 1.0) TextCoverageRun[] {
        if density <= 0.0 { panic("GFX.Canvas text coverage density must be positive") }
        self.ensure_runs()
        var result:TextCoverageRun[] = []
        if let command = self.current_command {
            match command {
                text(value) => {
                    let origin_x = self.aligned_origin_x(
                        value.position.x,
                        value.style.alignment
                    ) * density
                    var instance = value.style.typeface().instance(
                        value.style.size,
                        text_weight_key(value.style.weight),
                        value.style.variations
                    )
                    let baseline = Math.ceil(instance.metrics().ascender * density as float64) as int
                    var line_index = 0
                    while line_index < self.retained_runs.count() {
                        result.append(TextCoverageRun(
                            glyph_run:self.retained_runs[line_index],
                            origin:Math.Vec2(
                                Math.floor(origin_x + self.retained_offsets[line_index].x * density) / density,
                                (Math.floor(value.position.y * density +
                                    self.retained_offsets[line_index].y * density) + baseline as float) / density
                            ),
                            density:density
                        ))
                        line_index++
                    }
                }
                else => {}
            }
        }
        return result
    }

    module func matches(command:@Command, width:int, height:int) bool {
        if width != self.canvas_width || height != self.canvas_height { return false }
        if let current = self.current_command { return same_text(command, current) }
        return false
    }

    module func same_shaping(command:@Command) bool {
        if let current = self.current_command { return same_shaping_command(command, current) }
        return false
    }

    module func can_reposition(command:@Command, width:int, height:int) bool {
        if width != self.canvas_width || height != self.canvas_height {
            return false
        }
        if let current = self.current_command {
            if !same_raster_content(command, current) { return false }
            // Atlas and vector renderers retain shaped runs without creating a
            // layer raster. They can still move the layer at zero shaping cost.
            if self.retained == null { return true }
            if let retained = self.retained {
                let delta = text_position(command).subtract(text_position(current))
                return translated_axis_fits(
                    retained.origin.x,
                    retained.size.x,
                    delta.x,
                    width
                ) && translated_axis_fits(
                    retained.origin.y,
                    retained.size.y,
                    delta.y,
                    height
                )
            }
        }
        return false
    }

    func text_layer(scale:float = 1.0) Rasterizer.TextImage {
        if scale <= 0.0 { panic("GFX.Canvas text raster scale must be positive") }
        if !Math.nearly_equal(scale, self.retained_scale) || self.retained == null {
            if let command = self.current_command {
                var commands:Command[] = [command]
                if self.canvas_width > 0 && self.canvas_height > 0 {
                    self.retained = Rasterizer.rasterize_cropped_text(
                        commands,
                        self.canvas_width,
                        self.canvas_height,
                        scale
                    )
                } else {
                    self.retained = Rasterizer.rasterize_unbounded_text(commands, scale)
                }
            }
            self.retained_scale = scale
        }
        if let content = self.retained { return content }
        panic("GFX.Canvas could not cache a retained text layer")
    }

    module func ensure_runs() {
        if self.retained_runs_ready { return }
        if let command = self.current_command {
            match command {
                text(value) => {
                    if let block = value.block {
                        self.retained_runs = block.glyph_runs()
                        self.retained_offsets = block.run_offsets()
                        self.retained_width = block.run_width()
                        self.retained_runs_ready = true
                        return
                    }
                    var layout = text_runs(value.value, value.style)
                    self.retained_runs = layout.runs
                    self.retained_offsets = layout.offsets
                    self.retained_width = layout.width
                }
                else => {}
            }
        }
        self.retained_runs_ready = true
    }

    module func reuse_shaping(previous:@TextLayer) {
        self.current_shaping_revision = previous.current_shaping_revision
        if let runs = previous.ready_glyph_runs() {
            self.retained_runs = runs
            self.retained_offsets.clear()
            for offset in previous.retained_offsets { self.retained_offsets.append(offset) }
            self.retained_width = previous.retained_width
            self.retained_runs_ready = true
        }
    }

    module func reuse_repositioned_raster(previous:@TextLayer) {
        if let retained = previous.retained {
            if let current = self.current_command {
                if let old = previous.current_command {
                    let delta = text_position(current).subtract(text_position(old))
                    self.retained = Rasterizer.TextImage(
                        image:retained.image,
                        origin:Math.Vec2(
                            retained.origin.x + delta.x,
                            retained.origin.y + delta.y
                        ),
                        size:retained.size
                    )
                    self.retained_scale = previous.retained_scale
                }
            }
        }
    }

    private func run_baselines() Math.Vec2[] {
        var result:Math.Vec2[] = []
        if let command = self.current_command {
            match command {
                text(value) => {
                    let origin_x = self.aligned_origin_x(
                        value.position.x,
                        value.style.alignment
                    )
                    var instance = value.style.typeface().instance(
                        value.style.size,
                        text_weight_key(value.style.weight),
                        value.style.variations
                    )
                    let ascender = Math.ceil(instance.metrics().ascender) as int as float
                    var line = 0
                    while line < self.retained_runs.count() {
                        result.append(Math.Vec2(
                            origin_x + self.retained_offsets[line].x,
                            value.position.y + self.retained_offsets[line].y + ascender
                        ))
                        line++
                    }
                }
                else => {}
            }
        }
        return result
    }

    private func aligned_origin_x(
        position:float,
        alignment:TextAlignment
    ) float {
        if alignment == TextAlignment.start { return position }
        let width = self.retained_width
        if alignment == TextAlignment.center { return position - width * 0.5 }
        return position - width
    }
}

module func text_layer_unchanged(
    command:Command,
    width:int,
    height:int,
    previous:@TextLayer
) bool {
    return previous.matches(command, width, height)
}

module func updated_text_layer(
    command:Command,
    width:int,
    height:int,
    previous:@TextLayer
) TextLayer {
    var result = TextLayer.updated(
        command,
        width,
        height,
        previous.id(),
        previous.revision() + 1
    )
    if previous.same_shaping(command) {
        result.reuse_shaping(previous)
    }
    return result
}

module func text_layer_repositionable(
    command:Command,
    width:int,
    height:int,
    previous:@TextLayer
) bool {
    return previous.can_reposition(command, width, height)
}

module func repositioned_text_layer(
    command:Command,
    width:int,
    height:int,
    previous:@TextLayer
) TextLayer {
    var result = TextLayer.updated(
        command,
        width,
        height,
        previous.id(),
        previous.revision() + 1
    )
    result.reuse_shaping(previous)
    result.reuse_repositioned_raster(previous)
    return result
}

func text_weight_key(weight:TextWeight) int {
    if weight == TextWeight.bold { return 1 }
    return 0
}

func outline_identity(instance:VectorFont.Instance) str {
    var key = instance.face().identity()
    for variation in instance.variations() { key += "|$(variation.tag)=$(variation.value)" }
    let synthesis = instance.synthesis()
    return key + "|embolden=$(synthesis.embolden)|oblique=$(synthesis.oblique)"
}

func same_shaping_style(first:@TextStyle, second:@TextStyle) bool {
    return first.size == second.size &&
        first.weight == second.weight &&
        first.font == second.font &&
        first.fixed_advance == second.fixed_advance &&
        first.line_height == second.line_height &&
        same_text_variations(first.variations, second.variations)
}

func same_shaping_command(first:@Command, second:@Command) bool {
    match first {
        text(left) => {
            match second {
                text(right) => {
                    return same_text_content(left, right) &&
                        same_shaping_style(left.style, right.style)
                }
                else => {}
            }
        }
        else => {}
    }
    return false
}

func same_raster_content(first:@Command, second:@Command) bool {
    match first {
        text(left) => {
            match second {
                text(right) => {
                    return same_text_content(left, right) &&
                        same_text_style(left.style, right.style) &&
                        same_text_clip(left.clip, right.clip)
                }
                else => {}
            }
        }
        else => {}
    }
    return false
}

func text_position(command:@Command) Math.Vec2 {
    match command {
        text(value) => { return value.position }
        else => {}
    }
    return Math.Vec2()
}

func translated_axis_fits(origin:float, size:float, delta:float, frame:int) bool {
    if frame <= 0 || delta == 0.0 { return true }
    let translated = origin + delta
    return origin >= 0.0 && origin + size <= frame as float &&
        translated >= 0.0 && translated + size <= frame as float
}

func same_text(first:@Command, second:@Command) bool {
    match first {
        text(left) => {
            match second {
                text(right) => {
                    return same_text_content(left, right) &&
                        left.position == right.position &&
                        same_text_style(left.style, right.style) &&
                        same_text_clip(left.clip, right.clip)
                }
                else => {}
            }
        }
        else => {}
    }
    return false
}

func same_text_clip(first:@Rect?, second:@Rect?) bool {
    if let left = first {
        if let right = second {
            return left.position == right.position &&
                left.size == right.size &&
                left.radius == right.radius
        }
        return false
    }
    if let right = second { return false }
    return true
}
