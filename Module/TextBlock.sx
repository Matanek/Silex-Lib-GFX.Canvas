use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.TextRuns.text_runs
use STD.Math
use GFX.Font as VectorFont

// Stable retained text content. Its identity lets renderers cache shaping and
// GPU instances independently from placement, scrolling and clipping.
public class TextBlock {
    private static var next_identity:int = 1
    private let current_identity:int
    private var current_revision:int
    private var current_value:str
    private var current_style:TextStyle
    private var current_runs:VectorFont.GlyphRun[]
    private var current_offsets:Math.Vec2[] = []
    private var current_width:float = 0.0
    private var prepared:bool

    init(value:str, style:TextStyle = TextStyle()) {
        self.current_identity = TextBlock.next_identity
        TextBlock.next_identity++
        self.current_revision = 1
        self.current_value = value
        self.current_style = style
        self.current_runs = []
        self.prepared = false
    }

    func identity() int { return self.current_identity }
    func revision() int { return self.current_revision }
    func value() str { return self.current_value }
    func style() TextStyle { return self.current_style }

    // Replace retained content without changing the identity consumed by
    // Canvas and renderer caches.
    func replace(value:str) {
        if value == self.current_value { return }
        self.current_value = value
        self.current_revision++
        self.current_runs.clear()
        self.prepared = false
    }

    func prepare() {
        if self.prepared { return }
        var layout = text_runs(self.current_value, self.current_style)
        self.current_runs = layout.runs
        self.current_offsets = layout.offsets
        self.current_width = layout.width
        self.prepared = true
    }

    module func run_offsets() Math.Vec2[] {
        self.prepare()
        return self.current_offsets
    }
    module func run_width() float {
        self.prepare()
        return self.current_width
    }

    func glyph_runs() VectorFont.GlyphRun[] {
        self.prepare()
        return self.current_runs
    }
}
