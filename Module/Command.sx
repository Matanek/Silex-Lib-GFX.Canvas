use GFX.Canvas.Path.Path
use GFX.Canvas.Effects.Effect
use GFX.Canvas.Shapes.Circle
use GFX.Canvas.Shapes.Line
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Styles.Fill
use GFX.Canvas.Styles.fill_resource_revision
use GFX.Canvas.Styles.same_fill
use GFX.Canvas.Styles.Stroke
use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.Styles.same_text_style
use GFX.Canvas.TextBlock.TextBlock
use STD.Math

public struct FillRect { let shape:Rect; var style:Fill }
public struct StrokeRect { let shape:Rect; let style:Stroke }
public struct FillCircle { let shape:Circle; var style:Fill }
public struct StrokeCircle { let shape:Circle; let style:Stroke }
public struct StrokeLine { let shape:Line; let style:Stroke }
public struct FillPath { var shape:Path; var style:Fill }
public struct StrokePath { var shape:Path; let style:Stroke }
public struct Text {
    let value:str
    let position:Math.Vec2
    var style:TextStyle
    let clip:Rect?
    let block_identity:int
    let block_revision:int
    var block:TextBlock? = null

    init(
        value:str,
        position:Math.Vec2,
        style:TextStyle,
        clip:Rect? = null,
        block_identity:int = 0,
        block_revision:int = 0,
        block:TextBlock? = null
    ) {
        self.value = value
        self.position = position
        self.style = style
        self.clip = clip
        self.block_identity = block_identity
        self.block_revision = block_revision
        self.block = block
    }
}

public class Layer {
    private static var next_identity:int = 1
    private let current_identity:int
    private let current_revision:int
    private let current_effects:Effect[]
    private var current_commands:Command[]
    private let current_bounds:Rect?
    private let current_clip:Rect?

    private init(
        identity:int,
        revision:int,
        effects:Effect[],
        commands:Command[],
        bounds:Rect?,
        clip:Rect?
    ) {
        self.current_identity = identity
        self.current_revision = revision
        self.current_effects = effects
        self.current_commands = commands
        self.current_bounds = bounds
        self.current_clip = clip
    }

    func id() int { return self.current_identity }
    func revision() int {
        return self.current_revision + command_resource_revision(self.current_commands)
    }
    func effects() Effect[] { return self.current_effects }
    func commands() Command[] { return self.current_commands }
    func clip() Rect? { return self.current_clip }
    func bounds() Rect? {
        return GFX.Canvas.Rasterizer.clipped_bounds(
            GFX.Canvas.Rasterizer.logical_bounds(self.current_commands, self.current_effects),
            self.current_clip
        )
    }

    package static func retained(
        effects:Effect[],
        commands:Command[],
        bounds:Rect?,
        previous:Layer? = null,
        clip:Rect? = null
    ) Layer {
        if var retained = previous {
            if clip == retained.current_clip && same_effects(effects, retained.current_effects) &&
                same_commands(commands, retained.current_commands)
            {
                return retained
            }
            return Layer(
                retained.current_identity,
                retained.current_revision + 1,
                effects,
                commands,
                bounds,
                clip
            )
        }
        let identity = Layer.next_identity
        Layer.next_identity++
        return Layer(identity, 1, effects, commands, bounds, clip)
    }
}

package class CommandBuffer {
    private var current:Command[]
    private var previous:Command[]

    init(previous:Command[] = []) {
        self.current = []
        self.previous = previous
    }

    func count() int { return self.current.count() }
    func values() Command[] { return self.current }
    func append(command:Command) { self.current.append(command) }

    func reset() {
        self.previous = self.current
        self.current = []
    }

    func previous_layer(index:int) Layer? {
        if index < 0 || index >= self.previous.count() { return null }
        match self.previous[index] {
            layer(value) => { return optional_layer(value) }
            else => {}
        }
        return null
    }
}

func optional_layer(value:Layer) Layer? { return value }

module func same_text_content(first:@Text, second:@Text) bool {
    if first.block_identity > 0 || second.block_identity > 0 {
        return first.block_identity > 0 &&
            first.block_identity == second.block_identity &&
            first.block_revision == second.block_revision
    }
    return first.value == second.value
}

module func current_text(value:Text) Text {
    if let block = value.block {
        return Text(
            value:block.value(),
            position:value.position,
            style:block.style(),
            clip:value.clip,
            block_identity:block.identity(),
            block_revision:block.revision(),
            block:block
        )
    }
    return Text(
        value:value.value,
        position:value.position,
        style:value.style,
        clip:value.clip,
        block_identity:value.block_identity,
        block_revision:value.block_revision,
        block:value.block
    )
}

public enum Command {
    fill_rect(FillRect)
    stroke_rect(StrokeRect)
    fill_circle(FillCircle)
    stroke_circle(StrokeCircle)
    stroke_line(StrokeLine)
    fill_path(FillPath)
    stroke_path(StrokePath)
    text(Text)
    layer(Layer)
}

func same_effects(first:@Effect[], second:@Effect[]) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        if first[index] != second[index] { return false }
        index++
    }
    return true
}

func same_commands(first:@Command[], second:@Command[]) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        if !same_command(first[index], second[index]) { return false }
        index++
    }
    return true
}

func same_layer(first:@Layer, second:@Layer) bool {
    let first_effects = first.effects()
    let second_effects = second.effects()
    var first_commands = first.commands()
    var second_commands = second.commands()
    return first.clip() == second.clip() && same_effects(first_effects, second_effects) &&
        same_commands(first_commands, second_commands)
}

func same_command(first:@Command, second:@Command) bool {
    return match first {
        fill_rect(left) => match second {
            fill_rect(right) => left.shape == right.shape && same_fill(left.style, right.style)
            else => false
        }
        stroke_rect(left) => match second { stroke_rect(right) => left == right; else => false }
        fill_circle(left) => match second {
            fill_circle(right) => left.shape == right.shape && same_fill(left.style, right.style)
            else => false
        }
        stroke_circle(left) => match second { stroke_circle(right) => left == right; else => false }
        stroke_line(left) => match second { stroke_line(right) => left == right; else => false }
        fill_path(left) => match second {
            fill_path(right) => left.shape == right.shape && same_fill(left.style, right.style)
            else => false
        }
        stroke_path(left) => match second { stroke_path(right) => left == right; else => false }
        text(left) => match second {
            text(right) => same_text_content(left, right) && left.position == right.position &&
                same_text_style(left.style, right.style) && left.clip == right.clip
            else => false
        }
        layer(left) => match second {
            layer(right) => same_layer(left, right)
            else => false
        }
    }
}

module func command_resource_revision(commands:@Command[]) int {
    var revision = 0
    for command in commands {
        match command {
            fill_rect(value) => { revision += fill_resource_revision(value.style) }
            fill_circle(value) => { revision += fill_resource_revision(value.style) }
            fill_path(value) => {
                revision += value.shape.revision() + fill_resource_revision(value.style)
            }
            stroke_path(value) => { revision += value.shape.revision() }
            text(value) => {
                if let block = value.block { revision += block.revision() }
            }
            layer(value) => {
                var nested = value.commands()
                revision += command_resource_revision(nested)
            }
            else => {}
        }
    }
    return revision
}
