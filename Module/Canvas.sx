use GFX.Assets.Image
use GFX.Color
use GFX.Canvas.Command
use GFX.Canvas.Command.CommandBuffer
use GFX.Canvas.Command.Layer
use GFX.Canvas.Command.command_resource_revision
use GFX.Canvas.Effects.Effect
use GFX.Canvas.Geometry
use GFX.Canvas.Path.Path
use GFX.Canvas.Prepared.Prepared
use GFX.Canvas.Rasterizer
use GFX.Canvas.Shapes.Arc
use GFX.Canvas.Shapes.Circle
use GFX.Canvas.Shapes.Ellipse
use GFX.Canvas.Shapes.Line
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Shapes.Sector
use GFX.Canvas.Snapshot.Snapshot
use GFX.Canvas.Styles.Fill
use GFX.Canvas.Styles.Stroke
use GFX.Canvas.Styles.TextMetrics
use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.TextBlock.TextBlock
use GFX.Canvas.Vectorizer
use STD.Math

class PreparedCache {
    var value:Prepared
    let width:int
    let height:int
    let framed:bool
    var revision:int

    init(value:Prepared, width:int, height:int, framed:bool, revision:int) {
        self.value = value
        self.width = width
        self.height = height
        self.framed = framed
        self.revision = revision
    }

    func matches(width:int, height:int, framed:bool) bool {
        return self.width == width && self.height == height && self.framed == framed
    }
}

public class Canvas {
    private static var next_identity:int = 1
    private let identity:int
    private var command_buffer:CommandBuffer
    private var current_revision:int
    private var cached_preparations:PreparedCache[]
    private var cached_snapshot:Snapshot? = null
    private var cached_snapshot_revision:int = 0
    private var cached_snapshot_width:int = 0
    private var cached_snapshot_height:int = 0
    private var cached_snapshot_framed:bool = false

    init() {
        self.identity = Canvas.next_identity
        Canvas.next_identity++
        self.command_buffer = CommandBuffer()
        self.current_revision = 1
        self.cached_preparations = []
    }

    func paint(callback:func(&Painter)) Canvas {
        let previous_count = self.command_buffer.count()
        var painter = Painter(self.command_buffer)
        callback(painter)
        self.current_revision += self.command_buffer.count() - previous_count
        return self
    }

    func clear() {
        self.command_buffer.reset()
        self.current_revision++
    }

    func rasterize(width:int, height:int, background:Color = Color.transparent()) Image {
        var commands = self.command_buffer.values()
        return Rasterizer.rasterize(commands, width, height, background)
    }

    func measure_text(value:str, style:TextStyle = TextStyle()) TextMetrics {
        return Rasterizer.measure_text(value, style)
    }

    func commands() Command[] { return self.command_buffer.values() }
    func id() int { return self.identity }
    func revision() int {
        var commands = self.command_buffer.values()
        return self.current_revision + command_resource_revision(commands)
    }
    func is_empty() bool { return self.command_buffer.count() == 0 }
    func command_count() int { return self.command_buffer.count() }

    func vector_geometry_compatible() bool {
        var commands = self.command_buffer.values()
        return Vectorizer.compatible(commands)
    }

    func vector_geometry() Geometry.Mesh {
        var commands = self.command_buffer.values()
        if !Vectorizer.compatible(commands) {
            panic("GFX.Canvas vector geometry cannot represent effects or image fills; use content")
        }
        return Vectorizer.geometry(commands)
    }

    func prepare(prepared:&Prepared) {
        var commands = self.command_buffer.values()
        prepared.update(commands)
    }

    func prepare(prepared:&Prepared, width:int, height:int) {
        if width <= 0 || height <= 0 {
            panic("GFX.Canvas prepared dimensions must be positive")
        }
        var commands = self.command_buffer.values()
        prepared.update(commands, width, height)
    }

    // Returns one incrementally maintained retained compilation for each
    // unbounded or framed size used by renderers of this authored Canvas.
    func prepared() Prepared { return self.cached_prepared(0, 0, false) }

    func prepared(width:int, height:int) Prepared {
        if width <= 0 || height <= 0 {
            panic("GFX.Canvas prepared dimensions must be positive")
        }
        return self.cached_prepared(width, height, true)
    }

    func snapshot() Snapshot {
        let revision = self.revision()
        if self.cached_snapshot_revision == revision &&
            !self.cached_snapshot_framed
        {
            if let snapshot = self.cached_snapshot { return snapshot }
        }
        var commands = self.command_buffer.values()
        var snapshot = Snapshot(Vectorizer.geometry(commands), commands, self.identity)
        self.cached_snapshot = snapshot
        self.cached_snapshot_revision = revision
        self.cached_snapshot_width = 0
        self.cached_snapshot_height = 0
        self.cached_snapshot_framed = false
        return snapshot
    }

    func snapshot(width:int, height:int) Snapshot {
        if width <= 0 || height <= 0 {
            panic("GFX.Canvas snapshot dimensions must be positive")
        }
        let revision = self.revision()
        if self.cached_snapshot_revision == revision &&
            self.cached_snapshot_framed &&
            self.cached_snapshot_width == width && self.cached_snapshot_height == height
        {
            if let snapshot = self.cached_snapshot { return snapshot }
        }
        var snapshot = Snapshot(
            Vectorizer.geometry(self.command_buffer.values()),
            self.command_buffer.values(),
            width,
            height,
            self.identity
        )
        self.cached_snapshot = snapshot
        self.cached_snapshot_revision = revision
        self.cached_snapshot_width = width
        self.cached_snapshot_height = height
        self.cached_snapshot_framed = true
        return snapshot
    }

    // Incrementally compiles an unbounded retained snapshot while preserving
    // unchanged text-layer identities.
    func snapshot(reuse:@Snapshot) Snapshot {
        var snapshot = self.snapshot()
        snapshot.reuse_unchanged(reuse)
        return snapshot
    }

    // Incrementally compiles a retained snapshot. Custom renderers can provide
    // their previous snapshot so unchanged text coverage is preserved while
    // vector geometry evolves.
    func snapshot(width:int, height:int, reuse:@Snapshot) Snapshot {
        var snapshot = self.snapshot(width, height)
        snapshot.reuse_unchanged(reuse)
        return snapshot
    }

    module func text_image(width:int, height:int) Image {
        var commands = self.command_buffer.values()
        return Rasterizer.rasterize_text(commands, width, height)
    }

    module func has_text() bool {
        var commands = self.command_buffer.values()
        return commands_have_text(commands)
    }

    private func cached_prepared(width:int, height:int, framed:bool) Prepared {
        let revision = self.revision()
        var index = 0
        while index < self.cached_preparations.count() {
            var cached = self.cached_preparations[index]
            if cached.matches(width, height, framed) {
                if cached.revision != revision {
                    self.update_prepared(cached.value, width, height, framed)
                    cached.revision = revision
                }
                return cached.value
            }
            index++
        }
        var value = Prepared()
        self.update_prepared(value, width, height, framed)
        self.cached_preparations.append(PreparedCache(
            value,
            width,
            height,
            framed,
            revision
        ))
        return value
    }

    private func update_prepared(
        prepared:&Prepared,
        width:int,
        height:int,
        framed:bool
    ) {
        if framed {
            self.prepare(prepared, width, height)
        } else {
            self.prepare(prepared)
        }
    }
}

public struct Painter {
    private var commands:CommandBuffer

    module init(commands:CommandBuffer) { self.commands = commands }

    func layer(effects:Effect[], callback:func(&Painter)) {
        let index = self.commands.count()
        var previous = self.commands.previous_layer(index)
        var previous_commands:Command[] = []
        if let retained = previous { previous_commands = retained.commands() }
        var nested = CommandBuffer(previous_commands)
        var painter = Painter(nested)
        callback(painter)
        var commands = nested.values()
        let bounds = Rasterizer.logical_bounds(commands, effects)
        self.commands.append(Command.layer(Layer.retained(
            effects,
            commands,
            bounds,
            previous
        )))
    }

    func fill(shape:Rect, style:Fill) {
        validate_rect(shape)
        self.commands.append(Command.fill_rect(Command.FillRect(shape:shape, style:style)))
    }

    func stroke(shape:Rect, style:Stroke) {
        validate_rect(shape)
        self.commands.append(Command.stroke_rect(Command.StrokeRect(shape:shape, style:style)))
    }

    func fill(shape:Circle, style:Fill) {
        validate_circle(shape)
        self.commands.append(Command.fill_circle(Command.FillCircle(shape:shape, style:style)))
    }

    func stroke(shape:Circle, style:Stroke) {
        validate_circle(shape)
        self.commands.append(Command.stroke_circle(Command.StrokeCircle(shape:shape, style:style)))
    }

    func fill(shape:Ellipse, style:Fill) {
        validate_ellipse(shape)
        self.fill(ellipse_path(shape), style)
    }

    func stroke(shape:Ellipse, style:Stroke) {
        validate_ellipse(shape)
        self.stroke(ellipse_path(shape), style)
    }

    func stroke(shape:Arc, style:Stroke) {
        validate_arc(shape.radius, shape.sweep)
        self.stroke(arc_path(shape.center, shape.radius, shape.start, shape.sweep), style)
    }

    func fill(shape:Sector, style:Fill) {
        validate_arc(shape.radius, shape.sweep)
        var path = Path()
            ..move_to(shape.center)
            ..line_to(arc_point(shape.center, shape.radius, shape.start))
            ..arc_to(shape.center, shape.radius, shape.start, shape.sweep)
            ..close()
        self.fill(path, style)
    }

    func stroke(shape:Sector, style:Stroke) {
        validate_arc(shape.radius, shape.sweep)
        var path = Path()
            ..move_to(shape.center)
            ..line_to(arc_point(shape.center, shape.radius, shape.start))
            ..arc_to(shape.center, shape.radius, shape.start, shape.sweep)
            ..close()
        self.stroke(path, style)
    }

    func stroke(shape:Line, style:Stroke) {
        self.commands.append(Command.stroke_line(Command.StrokeLine(shape:shape, style:style)))
    }

    func fill(shape:Path, style:Fill) {
        if shape.is_empty() { panic("GFX.Canvas cannot fill an empty path") }
        self.commands.append(Command.fill_path(Command.FillPath(shape:shape, style:style)))
    }

    func stroke(shape:Path, style:Stroke) {
        if shape.is_empty() { panic("GFX.Canvas cannot stroke an empty path") }
        self.commands.append(Command.stroke_path(Command.StrokePath(shape:shape, style:style)))
    }

    func text(
        value:str,
        position:Math.Vec2,
        style:TextStyle = TextStyle(),
        clip:Rect? = null
    ) {
        if let bounds = clip { validate_text_clip(bounds) }
        self.commands.append(Command.text(Command.Text(
            value:value,
            position:position,
            style:style,
            clip:clip
        )))
    }

    func text_block(
        block:TextBlock,
        position:Math.Vec2,
        clip:Rect? = null
    ) {
        if let bounds = clip { validate_text_clip(bounds) }
        self.commands.append(Command.text(Command.Text(
            value:block.value(),
            position:position,
            style:block.style(),
            clip:clip,
            block_identity:block.identity(),
            block_revision:block.revision(),
            block:block
        )))
    }

}

func commands_have_text(commands:@Command[]) bool {
    for command in commands {
        match command {
            text(value) => { return true }
            layer(value) => {
                var nested = value.commands()
                if commands_have_text(nested) { return true }
            }
            else => {}
        }
    }
    return false
}

func validate_text_clip(shape:Rect) {
    if shape.size.x <= 0.0 || shape.size.y <= 0.0 {
        panic("GFX.Canvas text clip size must be positive")
    }
    if shape.radius != 0.0 {
        panic("GFX.Canvas text clip must be rectangular")
    }
}

func validate_rect(shape:Rect) {
    if shape.size.x <= 0.0 || shape.size.y <= 0.0 {
        panic("GFX.Canvas rectangle size must be positive")
    }
    if shape.radius < 0.0 { panic("GFX.Canvas rectangle radius cannot be negative") }
}

func validate_circle(shape:Circle) {
    if shape.radius <= 0.0 { panic("GFX.Canvas circle radius must be positive") }
}

func validate_ellipse(shape:Ellipse) {
    if shape.radii.x <= 0.0 || shape.radii.y <= 0.0 {
        panic("GFX.Canvas ellipse radii must be positive")
    }
}

func validate_arc(radius:float, sweep:float) {
    if radius <= 0.0 { panic("GFX.Canvas arc radius must be positive") }
    if sweep == 0.0 { panic("GFX.Canvas arc sweep cannot be zero") }
}

func arc_point(center:Math.Vec2, radius:float, angle:float) Math.Vec2 {
    return center.add(Math.Vec2(Math.cos(angle) * radius, Math.sin(angle) * radius))
}

func arc_path(center:Math.Vec2, radius:float, start:float, sweep:float) Path {
    return Path()
        ..move_to(arc_point(center, radius, start))
        ..arc_to(center, radius, start, sweep)
}

func ellipse_path(shape:Ellipse) Path {
    let segments = Rasterizer.round_curve_segments(
        Math.max(shape.radii.x, shape.radii.y),
        Math.two_pi()
    )
    var path = Path()
    var index = 0
    while index <= segments {
        let angle = Math.pi() * 2.0 * index as float / segments as float
        let point = shape.center.add(Math.Vec2(
            Math.cos(angle) * shape.radii.x,
            Math.sin(angle) * shape.radii.y
        ))
        if index == 0 { path.move_to(point) }
        else { path.line_to(point) }
        index++
    }
    path.close()
    return path
}
