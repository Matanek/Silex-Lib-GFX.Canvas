use GFX.Color
use GFX.Canvas.Font.Font
use GFX.Canvas.ImagePaint.ImageMapping
use GFX.Canvas.ImagePaint.ImagePaint
use GFX.Canvas.ImagePaint.same_image_mapping
use GFX.Font as VectorFont
use STD.Math

public struct Brush {
    private var gradient:bool
    private var start:Math.Vec2
    private var end:Math.Vec2
    private var start_color:Color
    private var end_color:Color

    module init() {
        self.gradient = false
        self.start = Math.Vec2()
        self.end = Math.Vec2()
        self.start_color = Color.white()
        self.end_color = Color.white()
    }

    static func solid(color:Color) Brush {
        var brush = Brush()
        brush.start_color = color
        brush.end_color = color
        return brush
    }

    static func linear(
        start:Math.Vec2,
        end:Math.Vec2,
        start_color:Color,
        end_color:Color
    ) Brush {
        if start.nearly_equal(end, Math.epsilon()) {
            panic("GFX.Canvas linear gradient endpoints must be distinct")
        }
        var brush = Brush()
        brush.gradient = true
        brush.start = start
        brush.end = end
        brush.start_color = start_color
        brush.end_color = end_color
        return brush
    }

    func color_at(position:Math.Vec2) Color {
        if !self.gradient { return self.start_color }
        let direction = self.end.subtract(self.start)
        let amount = Math.clamp(
            position.subtract(self.start).dot(direction) / direction.length_squared(),
            0.0,
            1.0
        )
        return self.start_color.lerp(self.end_color, amount)
    }
}

public struct Fill {
    private var current_brush:Brush
    private var current_image:ImagePaint? = null
    private var current_mapping:ImageMapping? = null

    init(color:Color) { self.current_brush = Brush.solid(color) }

    static func solid(color:Color) Fill { return Fill(color) }
    static func with_brush(brush:Brush) Fill {
        var fill = Fill(Color.white())
        fill.current_brush = brush
        return fill
    }

    static func image(paint:ImagePaint, mapping:ImageMapping) Fill {
        var fill = Fill(Color.white())
        fill.current_image = paint
        fill.current_mapping = mapping
        return fill
    }

    func is_image() bool { return self.current_image != null }
    func image_paint() ImagePaint {
        if let paint = self.current_image { return paint }
        panic("GFX.Canvas fill does not contain an ImagePaint")
    }
    func image_mapping() ImageMapping {
        if let mapping = self.current_mapping { return mapping }
        panic("GFX.Canvas fill does not contain an ImageMapping")
    }
    func brush() Brush {
        if self.is_image() {
            panic("GFX.Canvas image fill does not have a standalone Brush")
        }
        return self.current_brush
    }
    module func vector_brush() Brush { return self.current_brush }
}

module func same_fill(first:@Fill, second:@Fill) bool {
    if first.is_image() != second.is_image() { return false }
    if !first.is_image() { return first.vector_brush() == second.vector_brush() }
    var first_paint = first.image_paint()
    var second_paint = second.image_paint()
    let first_mapping = first.image_mapping()
    let second_mapping = second.image_mapping()
    return first_paint.id() == second_paint.id() &&
        same_image_mapping(first_mapping, second_mapping)
}

module func fill_resource_revision(fill:@Fill) int {
    if !fill.is_image() { return 0 }
    var paint = fill.image_paint()
    return paint.id() * 65537 + paint.revision()
}

public enum StrokeCap { butt; round; square }
public enum StrokeJoin { miter; round; bevel }

public struct Stroke {
    private var current_brush:Brush
    let width:float
    var cap:StrokeCap
    var join:StrokeJoin

    init(color:Color, width:float = 1.0) {
        if width <= 0.0 { panic("GFX.Canvas stroke width must be positive") }
        self.current_brush = Brush.solid(color)
        self.width = width
        self.cap = StrokeCap.butt
        self.join = StrokeJoin.miter
    }

    static func with_brush(brush:Brush, width:float = 1.0) Stroke {
        if width <= 0.0 { panic("GFX.Canvas stroke width must be positive") }
        var stroke = Stroke(Color.white(), width)
        stroke.current_brush = brush
        return stroke
    }

    func brush() Brush { return self.current_brush }
}

public enum TextAlignment { start; center; end }
public enum TextWeight { regular; bold }

func resolved_font(font:Font?) Font {
    if let custom_font = font { return custom_font }
    return Font.default()
}

public struct TextStyle {
    var size:float
    var color:Color
    var alignment:TextAlignment
    var weight:TextWeight
    var font:Font?
    var fixed_advance:float?
    var line_height:float?
    var variations:VectorFont.Variation[]

    init(
        size:float = 16.0,
        color:Color = Color(),
        alignment:TextAlignment = TextAlignment.start,
        weight:TextWeight = TextWeight.regular,
        font:Font? = null,
        fixed_advance:float? = null,
        line_height:float? = null,
        variations:VectorFont.Variation[] = []
    ) {
        if size <= 0.0 { panic("GFX.Canvas text size must be positive") }
        if let advance = fixed_advance {
            if advance <= 0.0 {
                panic("GFX.Canvas fixed text advance must be positive")
            }
        }
        if let height = line_height {
            if height <= 0.0 { panic("GFX.Canvas text line height must be positive") }
        }
        if weight == TextWeight.bold && has_weight_variation(variations) {
            panic("GFX.Canvas bold text cannot also specify a wght variation")
        }
        self.size = size
        self.color = color
        self.alignment = alignment
        self.weight = weight
        self.font = resolved_font(font)
        self.fixed_advance = fixed_advance
        self.line_height = line_height
        self.variations = variations
    }

    module func typeface() Font { return resolved_font(self.font) }
}

func has_weight_variation(variations:@VectorFont.Variation[]) bool {
    for variation in variations {
        if variation.tag == "wght" { return true }
    }
    return false
}

module func same_text_variations(
    first:@VectorFont.Variation[],
    second:@VectorFont.Variation[]
) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        if first[index].tag != second[index].tag || first[index].value != second[index].value {
            return false
        }
        index++
    }
    return true
}

module func same_text_style(first:@TextStyle, second:@TextStyle) bool {
    return first.size == second.size &&
        first.color == second.color &&
        first.alignment == second.alignment &&
        first.weight == second.weight &&
        first.font == second.font &&
        first.fixed_advance == second.fixed_advance &&
        first.line_height == second.line_height &&
        same_text_variations(first.variations, second.variations)
}

public struct TextMetrics {
    let width:float
    let height:float
    let lines:int
}
