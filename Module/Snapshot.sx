use GFX.Assets.Image
use GFX.Canvas.Geometry.Mesh
use GFX.Canvas.Command
use GFX.Canvas.Rasterizer
use GFX.Canvas.TextLayer.TextLayer
use STD.Math

public class Snapshot {
    private static var next_identity:int = 1
    private static var next_text_revision:int = 1
    private let identity:int
    private var retained_text_revision:int
    private let retained_geometry:Mesh
    private var retained_text:Rasterizer.TextImage? = null
    private let text_commands:Command[]
    private var retained_text_layers:TextLayer[]
    private let text_width:int
    private let text_height:int
    private var text_scale:float

    init() {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_text_revision = Snapshot.next_text_revision
        Snapshot.next_text_revision++
        self.retained_geometry = Mesh()
        self.text_commands = []
        self.retained_text_layers = []
        self.text_width = 1
        self.text_height = 1
        self.text_scale = 1.0
    }

    module init(geometry:Mesh, commands:Command[], width:int, height:int) {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_text_revision = Snapshot.next_text_revision
        Snapshot.next_text_revision++
        self.retained_geometry = geometry
        var retained_commands = retained_text_commands(commands)
        self.text_commands = retained_commands
        self.retained_text_layers = create_text_layers(
            retained_commands,
            width,
            height
        )
        self.text_width = width
        self.text_height = height
        self.text_scale = 1.0
    }

    func geometry() Mesh { return self.retained_geometry }
    func id() int { return self.identity }
    func text_revision() int { return self.retained_text_revision }
    func has_text() bool { return self.text_commands.count() > 0 }
    func text_layers() TextLayer[] { return self.retained_text_layers }
    func has_cached_text() bool { return self.retained_text != null }
    func text(scale:float = 1.0) Image {
        if !Math.nearly_equal(scale, self.text_scale) || self.retained_text == null {
            self.retained_text = Rasterizer.rasterize_cropped_text(
                self.text_commands,
                self.text_width,
                self.text_height,
                scale
            )
            self.text_scale = scale
        }
        if let layer = self.retained_text { return layer.image }
        panic("GFX retained drawing could not cache its text image")
    }

    func text_layer(scale:float = 1.0) Rasterizer.TextImage {
        let image = self.text(scale)
        if let layer = self.retained_text { return layer }
        panic("GFX retained drawing could not cache its text layer")
    }

    module func reuse_unchanged_text(previous:@Snapshot) {
        self.retain_text_layers(previous)
        if !same_text_commands(self.text_commands, previous.text_commands) { return }
        self.retained_text_revision = previous.retained_text_revision
        if let retained = previous.retained_text {
            self.retained_text = retained
            self.text_scale = previous.text_scale
        }
    }

    private func retain_text_layers(previous:@Snapshot) {
        var retained:TextLayer[] = []
        var index = 0
        while index < self.text_commands.count() {
            if index < previous.retained_text_layers.count() {
                retained.append(TextLayer.retain(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height,
                    previous.retained_text_layers[index]
                ))
            } else {
                retained.append(TextLayer(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height
                ))
            }
            index++
        }
        self.retained_text_layers = retained
    }
}

func create_text_layers(
    commands:@Command[],
    width:int,
    height:int
) TextLayer[] {
    var result:TextLayer[] = []
    for command in commands { result.append(TextLayer(command, width, height)) }
    return result
}

func retained_text_commands(commands:@Command[]) Command[] {
    var retained:Command[] = []
    for command in commands {
        match command {
            text(value) => { if value.value != "" { retained.append(Command.text(value)) } }
            else => {}
        }
    }
    return retained
}

func same_text_commands(first:@Command[], second:@Command[]) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        var equal = false
        match first[index] {
            text(left) => {
                match second[index] {
                    text(right) => {
                        equal = left.value == right.value &&
                            left.position == right.position &&
                            left.style == right.style
                    }
                    else => {}
                }
            }
            else => {}
        }
        if !equal { return false }
        index++
    }
    return true
}
