use GFX.Assets.Image
use GFX.Canvas.Geometry.Mesh
use GFX.Canvas.ImagePaint.ImageMapping
use GFX.Canvas.ImagePaint.ImagePaint
use GFX.Canvas.ImagePaint.validate_image_mapping
use GFX.Canvas.Command
use GFX.Canvas.Command.Layer
use GFX.Canvas.Effects.Effect
use GFX.Canvas.Command.same_text_content
use GFX.Canvas.Rasterizer
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.TextLayer.TextLayer
use GFX.Canvas.TextLayer.repositioned_text_layer
use GFX.Canvas.TextLayer.text_layer_repositionable
use GFX.Canvas.TextLayer.text_layer_unchanged
use GFX.Canvas.TextLayer.updated_text_layer
use GFX.Canvas.Styles.same_text_style
use GFX.Canvas.Vectorizer
use STD.Math

public class LayerContent {
    private let source_identity:int
    private let source_revision:int
    private let retained_effects:Effect[]
    private let retained_bounds:Rect?
    private var ordered:Content[]

    module init(source:@Layer, ordered:Content[]) {
        self.source_identity = source.id()
        self.source_revision = source.revision()
        self.retained_effects = source.effects()
        self.retained_bounds = source.bounds()
        self.ordered = ordered
    }

    func id() int { return self.source_identity }
    func revision() int { return self.source_revision }
    func effects() Effect[] { return self.retained_effects }
    func bounds() Rect? { return self.retained_bounds }
    func content() Content[] { return self.ordered }
}

// Complete retained intent for a vector mask filled from an ImagePaint. The
// mesh keeps its analytic distance coordinates; mapping remains separate.
public class ImageContent {
    private let retained_geometry:Mesh
    private var retained_paint:ImagePaint
    private let retained_mapping:ImageMapping

    module init(geometry:Mesh, paint:ImagePaint, mapping:ImageMapping) {
        let region = validate_image_mapping(paint, mapping)
        self.retained_geometry = geometry
        self.retained_paint = paint
        self.retained_mapping = mapping
    }

    func geometry() Mesh { return self.retained_geometry }
    func paint() ImagePaint { return self.retained_paint }
    func mapping() ImageMapping { return self.retained_mapping }
}

public enum Content {
    geometry(Mesh)
    image(ImageContent)
    text(TextLayer)
    layer(LayerContent)
}

public class Snapshot {
    private static var next_identity:int = 1
    private static var next_geometry_revision:int = 1
    private static var next_text_revision:int = 1
    private let identity:int
    private var retained_geometry_revision:int
    private var retained_text_revision:int
    private let retained_geometry:Mesh
    private let retained_geometry_compatible:bool
    private var retained_commands:Command[]
    private var retained_text:Rasterizer.TextImage? = null
    private var text_commands:Command[]
    private var retained_text_layers:TextLayer[]
    private var reusable_text_layers:TextLayer[]
    private let text_width:int
    private let text_height:int
    private var text_scale:float

    init() {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_geometry_revision = Snapshot.next_geometry_revision
        Snapshot.next_geometry_revision++
        self.retained_text_revision = Snapshot.next_text_revision
        Snapshot.next_text_revision++
        self.retained_geometry = Mesh()
        self.retained_geometry_compatible = true
        self.retained_commands = []
        self.text_commands = []
        self.retained_text_layers = []
        self.reusable_text_layers = []
        self.text_width = 1
        self.text_height = 1
        self.text_scale = 1.0
    }

    module init(geometry:Mesh, commands:@Command[], width:int, height:int) {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_geometry_revision = Snapshot.next_geometry_revision
        Snapshot.next_geometry_revision++
        self.retained_text_revision = Snapshot.next_text_revision
        Snapshot.next_text_revision++
        self.retained_geometry = geometry
        self.retained_geometry_compatible = Vectorizer.compatible(commands)
        self.retained_commands = copied_commands(commands)
        var retained_commands = retained_text_commands(commands)
        self.text_commands = retained_commands
        self.retained_text_layers = create_text_layers(
            retained_commands,
            width,
            height
        )
        self.reusable_text_layers = []
        self.text_width = width
        self.text_height = height
        self.text_scale = 1.0
    }

    module init(geometry:Mesh, commands:@Command[]) {
        self.identity = Snapshot.next_identity
        Snapshot.next_identity++
        self.retained_geometry_revision = Snapshot.next_geometry_revision
        Snapshot.next_geometry_revision++
        self.retained_text_revision = Snapshot.next_text_revision
        Snapshot.next_text_revision++
        self.retained_geometry = geometry
        self.retained_geometry_compatible = Vectorizer.compatible(commands)
        self.retained_commands = copied_commands(commands)
        var retained_commands = retained_text_commands(commands)
        self.text_commands = retained_commands
        self.retained_text_layers = create_text_layers(retained_commands, 0, 0)
        self.reusable_text_layers = []
        self.text_width = 0
        self.text_height = 0
        self.text_scale = 1.0
    }

    func vector_geometry_compatible() bool { return self.retained_geometry_compatible }
    func geometry() Mesh {
        if !self.retained_geometry_compatible {
            panic("GFX.Canvas snapshot geometry cannot represent effects or image fills; use content")
        }
        return self.retained_geometry
    }
    func id() int { return self.identity }
    func geometry_revision() int { return self.retained_geometry_revision }
    func text_revision() int { return self.retained_text_revision }
    func has_text() bool { return self.text_commands.count() > 0 }
    func text_layers() TextLayer[] { return self.retained_text_layers }
    func content() Content[] {
        var text_index = 0
        var layers = self.text_layers()
        return ordered_content(
            self.retained_commands,
            layers,
            text_index
        )
    }
    func has_cached_text() bool { return self.retained_text != null }
    func text(scale:float = 1.0) Image {
        if !Math.nearly_equal(scale, self.text_scale) || self.retained_text == null {
            if self.text_width > 0 && self.text_height > 0 {
                self.retained_text = Rasterizer.rasterize_cropped_text(
                    self.retained_commands,
                    self.text_width,
                    self.text_height,
                    scale
                )
            } else {
                self.retained_text = Rasterizer.rasterize_unbounded_text(
                    self.retained_commands,
                    scale
                )
            }
            self.text_scale = scale
        }
        if let layer = self.retained_text { return layer.image }
        panic("GFX retained drawing could not cache its text image")
    }

    func text_layer(scale:float = 1.0) Rasterizer.TextImage {
        let image = self.text(scale)
        if let layer = self.retained_text { return layer }
        panic("GFX retained drawing could not cache its text layer")
    }

    package func reuse_unchanged(previous:@Snapshot) {
        if same_geometry(self.retained_geometry, previous.retained_geometry) {
            self.retained_geometry_revision = previous.retained_geometry_revision
        }
        self.retain_text_layers(previous)
        if !same_text_commands(self.text_commands, previous.text_commands) { return }
        if self.text_width != previous.text_width ||
            self.text_height != previous.text_height
        {
            return
        }
        self.retained_text_revision = previous.retained_text_revision
        if let retained = previous.retained_text {
            self.retained_text = retained
            self.text_scale = previous.text_scale
        }
    }

    private func retain_text_layers(previous:@Snapshot) {
        var retained:TextLayer[] = []
        var candidates = previous.text_retention_candidates()
        var used:bool[] = []
        for layer in candidates { used.append(false) }
        var index = 0
        while index < self.text_commands.count() {
            if index < candidates.count() && !used[index] {
                if text_layer_unchanged(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height,
                    candidates[index]
                ) {
                    retained.append(candidates[index])
                    used[index] = true
                    index++
                    continue
                }
            }
            var moved = -1
            var previous_index = 0
            while previous_index < candidates.count() {
                if !used[previous_index] && text_layer_repositionable(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height,
                    candidates[previous_index]
                ) {
                    moved = previous_index
                    break
                }
                previous_index++
            }
            if moved >= 0 {
                retained.append(repositioned_text_layer(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height,
                    candidates[moved]
                ))
                used[moved] = true
            } else if index < candidates.count() && !used[index] {
                retained.append(updated_text_layer(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height,
                    candidates[index]
                ))
                used[index] = true
            } else {
                retained.append(TextLayer(
                    self.text_commands[index],
                    self.text_width,
                    self.text_height
                ))
            }
            index++
        }
        self.retained_text_layers = retained
        var reusable:TextLayer[] = []
        var candidate = 0
        while candidate < candidates.count() && reusable.count() < 192 {
            if !used[candidate] { reusable.append(candidates[candidate]) }
            candidate++
        }
        self.reusable_text_layers = reusable
    }

    private func text_retention_candidates() TextLayer[] {
        var result:TextLayer[] = []
        for layer in self.retained_text_layers { result.append(layer) }
        for layer in self.reusable_text_layers { result.append(layer) }
        return result
    }
}

func same_geometry(first:@Mesh, second:@Mesh) bool {
    let first_vertices = first.vertex_view()
    let second_vertices = second.vertex_view()
    if first_vertices.count() != second_vertices.count() { return false }
    let first_indices = first.index_view()
    let second_indices = second.index_view()
    if first_indices.count() != second_indices.count() { return false }
    var index = 0
    while index < first_vertices.count() {
        let left = first_vertices[index]
        let right = second_vertices[index]
        if left.position != right.position || left.normal != right.normal ||
            left.uv != right.uv || left.color != right.color
        {
            return false
        }
        index++
    }
    index = 0
    while index < first_indices.count() {
        if first_indices[index] != second_indices[index] { return false }
        index++
    }
    return true
}

package func retained_text_snapshot(commands:@Command[], width:int, height:int) Snapshot {
    return Snapshot(Mesh(), commands, width, height)
}

package func retained_unbounded_text_snapshot(commands:@Command[]) Snapshot {
    return Snapshot(Mesh(), commands)
}

func create_text_layers(
    commands:@Command[],
    width:int,
    height:int
) TextLayer[] {
    var result:TextLayer[] = []
    for command in commands { result.append(TextLayer(command, width, height)) }
    return result
}

func retained_text_commands(commands:@Command[]) Command[] {
    var retained:Command[] = []
    for command in commands {
        match command {
            text(value) => { if value.value != "" { retained.append(Command.text(value)) } }
            layer(value) => {
                var nested = value.commands()
                var nested_text = retained_text_commands(nested)
                for text in nested_text { retained.append(text) }
            }
            else => {}
        }
    }
    return retained
}

func copied_commands(commands:@Command[]) Command[] {
    var result:Command[] = []
    for command in commands { result.append(command) }
    return result
}

func ordered_content(
    commands:@Command[],
    text_layers:TextLayer[],
    text_index:&int
) Content[] {
    var result:Content[] = []
    for command in commands {
        match command {
            text(value) => {
                if value.value != "" {
                    result.append(Content.text(text_layers[text_index]))
                    text_index++
                }
            }
            layer(value) => {
                var nested = value.commands()
                var nested_content = ordered_content(nested, text_layers, text_index)
                result.append(Content.layer(LayerContent(value, nested_content)))
            }
            fill_rect(value) => {
                if value.style.is_image() {
                    result.append(Content.image(ImageContent(
                        Vectorizer.command_geometry(command),
                        value.style.image_paint(),
                        value.style.image_mapping()
                    )))
                } else {
                    result.append(Content.geometry(Vectorizer.command_geometry(command)))
                }
            }
            fill_circle(value) => {
                if value.style.is_image() {
                    result.append(Content.image(ImageContent(
                        Vectorizer.command_geometry(command),
                        value.style.image_paint(),
                        value.style.image_mapping()
                    )))
                } else {
                    result.append(Content.geometry(Vectorizer.command_geometry(command)))
                }
            }
            fill_path(value) => {
                if value.style.is_image() {
                    result.append(Content.image(ImageContent(
                        Vectorizer.command_geometry(command),
                        value.style.image_paint(),
                        value.style.image_mapping()
                    )))
                } else {
                    result.append(Content.geometry(Vectorizer.command_geometry(command)))
                }
            }
            else => { result.append(Content.geometry(Vectorizer.command_geometry(command))) }
        }
    }
    return result
}


func same_text_commands(first:@Command[], second:@Command[]) bool {
    if first.count() != second.count() { return false }
    var index = 0
    while index < first.count() {
        var equal = false
        match first[index] {
            text(left) => {
                match second[index] {
                    text(right) => {
                        equal = same_text_content(left, right) &&
                            left.position == right.position &&
                            same_text_style(left.style, right.style) &&
                            same_snapshot_text_clip(left.clip, right.clip)
                    }
                    else => {}
                }
            }
            else => {}
        }
        if !equal { return false }
        index++
    }
    return true
}

func same_snapshot_text_clip(first:@Rect?, second:@Rect?) bool {
    if let left = first {
        if let right = second {
            return left.position == right.position &&
                left.size == right.size &&
                left.radius == right.radius
        }
        return false
    }
    if let right = second { return false }
    return true
}
