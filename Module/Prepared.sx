use GFX.Canvas.Command
use GFX.Canvas.Geometry.Mesh
use GFX.Canvas.Snapshot.Snapshot
use GFX.Canvas.Snapshot.retained_text_snapshot
use GFX.Canvas.Snapshot.retained_unbounded_text_snapshot
use GFX.Canvas.TextLayer.TextLayer
use GFX.Canvas.Vectorizer

// Retained, reusable Canvas compilation for renderers that update the same
// drawing over time. Geometry storage alternates between two allocations so
// previous contents remain comparable without rebuilding allocation capacity.
public class Prepared {
    private static var next_revision:int = 1
    private static var next_geometry_revision:int = 1
    private var current_revision:int
    private var current_geometry_revision:int
    private var retained_geometry:Mesh
    private var staging_geometry:Mesh
    private var retained_text:Snapshot

    init() {
        self.current_revision = 0
        self.current_geometry_revision = 0
        self.retained_geometry = Mesh()
        self.staging_geometry = Mesh()
        self.retained_text = Snapshot()
    }

    func revision() int { return self.current_revision }
    func geometry_revision() int { return self.current_geometry_revision }
    func geometry() Mesh { return self.retained_geometry }
    func has_text() bool { return self.retained_text.has_text() }
    func text_layers() TextLayer[] { return self.retained_text.text_layers() }

    package func update(commands:@Command[]) {
        var text = retained_unbounded_text_snapshot(commands)
        self.commit(commands, text)
    }

    package func update(commands:@Command[], width:int, height:int) {
        var text = retained_text_snapshot(commands, width, height)
        self.commit(commands, text)
    }

    private func commit(commands:@Command[], text:Snapshot) {
        Vectorizer.update(commands, self.staging_geometry)
        if !same_mesh(self.retained_geometry, self.staging_geometry) {
            var previous = self.retained_geometry
            self.retained_geometry = self.staging_geometry
            self.staging_geometry = previous
            self.current_geometry_revision = Prepared.next_geometry_revision
            Prepared.next_geometry_revision++
        }
        var retained = text
        retained.reuse_unchanged(self.retained_text)
        self.retained_text = retained
        self.current_revision = Prepared.next_revision
        Prepared.next_revision++
    }
}

func same_mesh(first:@Mesh, second:@Mesh) bool {
    let first_vertices = first.vertex_view()
    let second_vertices = second.vertex_view()
    if first_vertices.count() != second_vertices.count() { return false }
    let first_indices = first.index_view()
    let second_indices = second.index_view()
    if first_indices.count() != second_indices.count() { return false }
    var index = 0
    while index < first_vertices.count() {
        let left = first_vertices[index]
        let right = second_vertices[index]
        if left.position != right.position || left.normal != right.normal ||
            left.uv != right.uv || left.color != right.color
        {
            return false
        }
        index++
    }
    index = 0
    while index < first_indices.count() {
        if first_indices[index] != second_indices[index] { return false }
        index++
    }
    return true
}
