use GFX.Assets.Image
use GFX.Canvas.PackedStorage.packed_storage
use GFX.Color
use GFX.Canvas.Command
use GFX.Canvas.Command.current_text
use GFX.Canvas.Effects.Effect
use GFX.Canvas.Path.Path
use GFX.Canvas.Path.Step
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Styles.Brush
use GFX.Canvas.Styles.Fill
use GFX.Canvas.ImagePaint.ImageFit
use GFX.Canvas.ImagePaint.ImageMapping
use GFX.Canvas.ImagePaint.ImageMappingKind
use GFX.Canvas.ImagePaint.ImageSampling
use GFX.Canvas.ImagePaint.validate_image_mapping
use GFX.Canvas.Styles.TextAlignment
use GFX.Canvas.Styles.TextMetrics
use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.Styles.TextWeight
use GFX.Canvas.Font.Font
use GFX.Canvas.Font.TextRaster
use GFX.Canvas.Font.CachedTextMetrics
use GFX.Font as VectorFont
use STD.Math
use STD.Text as StandardText
use STD.Text.Grapheme
use Interop.C

struct Polyline {
    var points:Math.Vec2[]
    var closed:bool
}

struct RectFillCoverage { let position:Math.Vec2; let size:Math.Vec2; let radius:float }
struct RectStrokeCoverage { let position:Math.Vec2; let size:Math.Vec2; let radius:float; let width:float }
struct CircleFillCoverage { let center:Math.Vec2; let radius:float }
struct CircleStrokeCoverage { let center:Math.Vec2; let radius:float; let width:float }
struct LineStrokeCoverage { let start:Math.Vec2; let end:Math.Vec2; let width:float }

enum Coverage {
    rect_fill(RectFillCoverage)
    rect_stroke(RectStrokeCoverage)
    circle_fill(CircleFillCoverage)
    circle_stroke(CircleStrokeCoverage)
    line_stroke(LineStrokeCoverage)
}

struct Bounds {
    let minimum:Math.Vec2
    let maximum:Math.Vec2
}

struct RasterImageFill {
    let pixels:uint8[]
    let width:int
    let height:int
    let region:Image.Region
    let mapping:ImageMapping
}

package func logical_bounds(commands:@Command[], effects:@Effect[] = []) Rect? {
    var result:Bounds? = null
    for command in commands {
        if let current = command_bounds(command) {
            result = include_bounds(result, current)
        }
    }
    if let retained = result {
        let expanded = effect_bounds(retained, effects)
        return Rect(expanded.minimum, expanded.maximum.subtract(expanded.minimum))
    }
    return null
}

func command_bounds(command:@Command) Bounds? {
    return match command {
        fill_rect(value) => optional_bounds(Bounds(
            minimum:value.shape.position,
            maximum:value.shape.position.add(value.shape.size)
        ))
        stroke_rect(value) => optional_bounds(expanded_bounds(
            value.shape.position,
            value.shape.position.add(value.shape.size),
            value.style.width * 0.5
        ))
        fill_circle(value) => optional_bounds(expanded_bounds(
            value.shape.center,
            value.shape.center,
            value.shape.radius
        ))
        stroke_circle(value) => optional_bounds(expanded_bounds(
            value.shape.center,
            value.shape.center,
            value.shape.radius + value.style.width * 0.5
        ))
        stroke_line(value) => optional_bounds(expanded_bounds(
            value.shape.start.minimum(value.shape.end),
            value.shape.start.maximum(value.shape.end),
            value.style.width * 0.5
        ))
        fill_path(value) => optional_bounds(polyline_bounds(flatten(value.shape), 0.0))
        stroke_path(value) => optional_bounds(polyline_bounds(
            flatten(value.shape), value.style.width * 0.5
        ))
        text(value) => text_bounds(value)
        layer(value) => layer_bounds(value)
    }
}

func optional_bounds(value:Bounds) Bounds? { return value }

func layer_bounds(value:@Command.Layer) Bounds? {
    if let retained = value.bounds() {
        return Bounds(
            minimum:retained.position,
            maximum:retained.position.add(retained.size)
        )
    }
    return null
}

func text_bounds(value:Command.Text) Bounds? {
    var retained = current_text(value)
    if retained.value == "" { return null }
    let metrics = measure_text(retained.value, retained.style)
    let left = aligned_text_left(
        retained.position.x,
        metrics.width,
        retained.style.alignment
    )
    var result = Bounds(
        minimum:Math.Vec2(left, retained.position.y),
        maximum:Math.Vec2(left + metrics.width, retained.position.y + metrics.height)
    )
    if let clip = retained.clip {
        result = Bounds(
            minimum:result.minimum.maximum(clip.position),
            maximum:result.maximum.minimum(clip.position.add(clip.size))
        )
        if result.maximum.x <= result.minimum.x || result.maximum.y <= result.minimum.y {
            return null
        }
    }
    return result
}

func aligned_text_left(position:float, width:float, alignment:TextAlignment) float {
    if alignment == TextAlignment.center { return position - width * 0.5 }
    if alignment == TextAlignment.end { return position - width }
    return position
}

func include_bounds(current:Bounds?, value:Bounds) Bounds {
    if let retained = current {
        return Bounds(
            minimum:retained.minimum.minimum(value.minimum),
            maximum:retained.maximum.maximum(value.maximum)
        )
    }
    return value
}

func effect_bounds(source:Bounds, effects:@Effect[]) Bounds {
    var result = source
    for effect in effects {
        match effect.value() {
            blur(value) => {
                result = expanded_bounds(result.minimum, result.maximum, value.radius)
            }
            shadow(value) => {
                let shadow = expanded_bounds(
                    result.minimum.add(value.offset),
                    result.maximum.add(value.offset),
                    value.radius
                )
                result = Bounds(
                    minimum:result.minimum.minimum(shadow.minimum),
                    maximum:result.maximum.maximum(shadow.maximum)
                )
            }
            opacity(value) => {}
        }
    }
    return result
}

public struct TextImage {
    let image:Image
    let origin:Math.Vec2
    let size:Math.Vec2
}

func rasterize(commands:@Command[], width:int, height:int, background:Color) Image {
    return rasterize_selected(commands, width, height, background, true, true)
}

func rasterize_text(
    commands:@Command[],
    width:int,
    height:int,
    scale:float = 1.0
) Image {
    if scale <= 0.0 { panic("GFX.Canvas text raster scale must be positive") }
    return rasterize_selected(
        commands,
        Math.ceil(width as float * scale) as int,
        Math.ceil(height as float * scale) as int,
        Color.transparent(),
        false,
        true,
        scale
    )
}

func rasterize_cropped_text(
    commands:@Command[],
    width:int,
    height:int,
    scale:float = 1.0
) TextImage {
    return rasterize_text_bounds(commands, width, height, scale, true)
}

func rasterize_unbounded_text(
    commands:@Command[],
    scale:float = 1.0
) TextImage {
    return rasterize_text_bounds(commands, 0, 0, scale, false)
}

local func rasterize_text_bounds(
    commands:@Command[],
    width:int,
    height:int,
    scale:float,
    clipped:bool
) TextImage {
    if scale <= 0.0 { panic("GFX.Canvas text raster scale must be positive") }
    var retained = text_commands_bounds(commands)
    if retained == null {
        return TextImage(image:Image(), origin:Math.Vec2(), size:Math.Vec2())
    }
    var logical = retained!
    var left = Math.floor(logical.minimum.x * scale)
    var top = Math.floor(logical.minimum.y * scale)
    var right = Math.ceil(logical.maximum.x * scale)
    var bottom = Math.ceil(logical.maximum.y * scale)
    if clipped {
        let maximum = Math.Vec2(width as float * scale, height as float * scale)
        left = Math.max(0.0, left)
        top = Math.max(0.0, top)
        right = Math.min(maximum.x, right)
        bottom = Math.min(maximum.y, bottom)
    }
    if right <= left || bottom <= top {
        return TextImage(image:Image(), origin:Math.Vec2(), size:Math.Vec2())
    }
    let cropped_width = (right - left) as int
    let cropped_height = (bottom - top) as int
    let origin = Math.Vec2(left, top)
    return TextImage(
        image:rasterize_selected(
            commands,
            cropped_width,
            cropped_height,
            Color.transparent(),
            false,
            true,
            scale,
            origin
        ),
        origin:origin.multiply(1.0 / scale),
        size:Math.Vec2(cropped_width as float / scale, cropped_height as float / scale)
    )
}

func text_commands_bounds(commands:@Command[]) Bounds? {
    var result:Bounds? = null
    for command in commands {
        match command {
            text(value) => {
                if let current = text_bounds(value) { result = include_bounds(result, current) }
            }
            layer(value) => {
                var nested = value.commands()
                if let current = text_commands_bounds(nested) {
                    let effects = value.effects()
                    result = include_bounds(result, effect_bounds(current, effects))
                }
            }
            else => {}
        }
    }
    return result
}

func rasterize_selected(
    commands:@Command[],
    width:int,
    height:int,
    background:Color,
    include_shapes:bool,
    include_text:bool,
    text_scale:float = 1.0,
    text_origin:Math.Vec2 = Math.Vec2()
) Image {
    if width <= 0 || height <= 0 {
        panic("GFX.Canvas raster dimensions must be positive")
    }
    var pixels = packed_storage(width * height * 4)
    let address = C.address_bits(C.mutable_string_pointer(pixels))
    let red = color_channel(background.r)
    let green = color_channel(background.g)
    let blue = color_channel(background.b)
    let alpha = color_channel(background.a)
    var pixel = 0
    while pixel < width * height {
        write_byte(address, pixel * 4, red)
        write_byte(address, pixel * 4 + 1, green)
        write_byte(address, pixel * 4 + 2, blue)
        write_byte(address, pixel * 4 + 3, alpha)
        pixel++
    }

    draw_commands(
        address,
        width,
        height,
        commands,
        include_shapes,
        include_text,
        text_scale,
        text_origin
    )
    return Image.packed_rgba8(width, height, pixels)
}

func draw_commands(
    address:uint,
    width:int,
    height:int,
    commands:@Command[],
    include_shapes:bool,
    include_text:bool,
    text_scale:float,
    text_origin:Math.Vec2
) {
    for command in commands {
        match command {
            fill_rect(value) => {
                if !include_shapes { continue }
                draw_fill_covered(address, width, height, value.style, Coverage.rect_fill(RectFillCoverage(
                    position:value.shape.position.subtract(text_origin), size:value.shape.size, radius:value.shape.radius
                )), text_origin)
            }
            stroke_rect(value) => {
                if !include_shapes { continue }
                draw_covered(address, width, height, value.style.brush(), Coverage.rect_stroke(RectStrokeCoverage(
                    position:value.shape.position.subtract(text_origin), size:value.shape.size, radius:value.shape.radius, width:value.style.width
                )), text_origin)
            }
            fill_circle(value) => {
                if !include_shapes { continue }
                draw_fill_covered(address, width, height, value.style, Coverage.circle_fill(CircleFillCoverage(
                    center:value.shape.center.subtract(text_origin), radius:value.shape.radius
                )), text_origin)
            }
            stroke_circle(value) => {
                if !include_shapes { continue }
                draw_covered(address, width, height, value.style.brush(), Coverage.circle_stroke(CircleStrokeCoverage(
                    center:value.shape.center.subtract(text_origin), radius:value.shape.radius, width:value.style.width
                )), text_origin)
            }
            stroke_line(value) => {
                if !include_shapes { continue }
                draw_covered(address, width, height, value.style.brush(), Coverage.line_stroke(LineStrokeCoverage(
                    start:value.shape.start.subtract(text_origin), end:value.shape.end.subtract(text_origin), width:value.style.width
                )), text_origin)
            }
            fill_path(value) => {
                if !include_shapes { continue }
                let polyline = translated_polyline(flatten(value.shape), text_origin)
                draw_fill_path(address, width, height, value.style, polyline, text_origin)
            }
            stroke_path(value) => {
                if !include_shapes { continue }
                let polyline = translated_polyline(flatten(value.shape), text_origin)
                draw_path(address, width, height, value.style.brush(), polyline,
                    value.style.width * 0.5, false, text_origin)
            }
            text(value) => {
                if !include_text { continue }
                var retained = current_text(value)
                var clip:Rect? = null
                if let bounds = retained.clip {
                    clip = Rect(
                        bounds.position.multiply(text_scale).subtract(text_origin),
                        bounds.size.multiply(text_scale)
                    )
                }
                draw_text(
                    address,
                    width,
                    height,
                    retained.value,
                    Math.Vec2(
                        retained.position.x * text_scale - text_origin.x,
                        retained.position.y * text_scale - text_origin.y
                    ),
                    retained.style,
                    text_scale,
                    clip
                )
            }
            layer(value) => {
                var nested = value.commands()
                let effects = value.effects()
                if effects.count() == 0 {
                    draw_commands(
                        address,
                        width,
                        height,
                        nested,
                        include_shapes,
                        include_text,
                        text_scale,
                        text_origin
                    )
                    continue
                }
                if let bounds = value.bounds() {
                    let left = Math.floor(bounds.position.x * text_scale)
                    let top = Math.floor(bounds.position.y * text_scale)
                    let right = Math.ceil((bounds.position.x + bounds.size.x) * text_scale)
                    let bottom = Math.ceil((bounds.position.y + bounds.size.y) * text_scale)
                    let layer_width = Math.max(1.0, right - left) as int
                    let layer_height = Math.max(1.0, bottom - top) as int
                    let layer_origin = Math.Vec2(left, top)
                    let isolated = rasterize_selected(
                        nested,
                        layer_width,
                        layer_height,
                        Color.transparent(),
                        include_shapes,
                        include_text,
                        text_scale,
                        layer_origin
                    )
                    let effected = apply_effects(isolated, effects, text_scale)
                    composite_image(
                        address,
                        width,
                        height,
                        effected,
                        Math.Vec2(left - text_origin.x, top - text_origin.y)
                    )
                }
            }
        }
    }
}

func translated_polyline(source:Polyline, origin:Math.Vec2) Polyline {
    var points:Math.Vec2[] = []
    for point in source.points { points.append(point.subtract(origin)) }
    return Polyline(points:points, closed:source.closed)
}

// Effects are evaluated in premultiplied linear storage even though Image's
// public RGBA8 representation is straight alpha. This prevents transparent
// coloured texels from bleeding into blurred edges.
func apply_effects(image:Image, effects:@Effect[], scale:float) Image {
    let width = image.width()
    let height = image.height()
    var current = premultiplied_pixels(image)
    for effect in effects {
        match effect.value() {
            blur(value) => {
                current = blur_premultiplied(current, width, height, value.radius * scale)
            }
            opacity(value) => { apply_opacity(current, value.value) }
            shadow(value) => {
                current = apply_shadow(
                    current,
                    width,
                    height,
                    value.offset.multiply(scale),
                    value.radius * scale,
                    value.color
                )
            }
        }
    }
    return straight_image(current, width, height)
}

func premultiplied_pixels(image:@Image) float[] {
    let source = image.pixels()
    var result:float[] = []
    var index = 0
    while index < source.count() {
        let alpha = source[index + 3] as float / 255.0
        result.append(source[index] as float / 255.0 * alpha)
        result.append(source[index + 1] as float / 255.0 * alpha)
        result.append(source[index + 2] as float / 255.0 * alpha)
        result.append(alpha)
        index += 4
    }
    return result
}

func straight_image(values:@float[], width:int, height:int) Image {
    var pixels:uint8[] = []
    var index = 0
    while index < values.count() {
        let alpha = Math.clamp(values[index + 3], 0.0, 1.0)
        if alpha <= 0.0 {
            pixels.append(0 as uint8); pixels.append(0 as uint8)
            pixels.append(0 as uint8); pixels.append(0 as uint8)
        } else {
            pixels.append(color_channel(values[index] / alpha))
            pixels.append(color_channel(values[index + 1] / alpha))
            pixels.append(color_channel(values[index + 2] / alpha))
            pixels.append(color_channel(alpha))
        }
        index += 4
    }
    return Image.rgba8(width, height, pixels)
}

func apply_opacity(values:&float[], opacity:float) {
    var index = 0
    while index < values.count() {
        values[index] *= opacity
        index++
    }
}

func gaussian_kernel(radius:float) float[] {
    if radius <= 0.0 { return [1.0] }
    let support = Math.max(1.0, Math.ceil(radius)) as int
    let sigma = Math.max(radius / 3.0, 1.0 / 3.0)
    let denominator = 2.0 * sigma * sigma
    var result:float[] = []
    var total = 0.0
    var offset = -support
    while offset <= support {
        let distance = offset as float
        let weight = Math.exp(-(distance * distance) / denominator)
        result.append(weight)
        total += weight
        offset++
    }
    var index = 0
    while index < result.count() {
        result[index] /= total
        index++
    }
    return result
}

func blur_premultiplied(
    source:@float[],
    width:int,
    height:int,
    radius:float
) float[] {
    if radius <= 0.0 { return copied_floats(source) }
    let kernel = gaussian_kernel(radius)
    let support = kernel.count() / 2
    var horizontal:float[] = []
    var vertical:float[] = []
    var value = 0
    while value < source.count() { horizontal.append(0.0); vertical.append(0.0); value++ }

    var y = 0
    while y < height {
        var x = 0
        while x < width {
            var channel = 0
            while channel < 4 {
                var sum = 0.0
                var kernel_index = 0
                while kernel_index < kernel.count() {
                    let sample_x = x + kernel_index - support
                    if sample_x >= 0 && sample_x < width {
                        sum += source[(y * width + sample_x) * 4 + channel] *
                            kernel[kernel_index]
                    }
                    kernel_index++
                }
                horizontal[(y * width + x) * 4 + channel] = sum
                channel++
            }
            x++
        }
        y++
    }

    y = 0
    while y < height {
        var x = 0
        while x < width {
            var channel = 0
            while channel < 4 {
                var sum = 0.0
                var kernel_index = 0
                while kernel_index < kernel.count() {
                    let sample_y = y + kernel_index - support
                    if sample_y >= 0 && sample_y < height {
                        sum += horizontal[(sample_y * width + x) * 4 + channel] *
                            kernel[kernel_index]
                    }
                    kernel_index++
                }
                vertical[(y * width + x) * 4 + channel] = sum
                channel++
            }
            x++
        }
        y++
    }
    return vertical
}

func copied_floats(source:@float[]) float[] {
    var result:float[] = []
    for value in source { result.append(value) }
    return result
}

func apply_shadow(
    source:@float[],
    width:int,
    height:int,
    offset:Math.Vec2,
    radius:float,
    color:Color
) float[] {
    var mask:float[] = []
    var pixel = 0
    while pixel < width * height {
        let alpha = source[pixel * 4 + 3]
        mask.append(alpha); mask.append(alpha); mask.append(alpha); mask.append(alpha)
        pixel++
    }
    let blurred = blur_premultiplied(mask, width, height, radius)
    var result:float[] = []
    var y = 0
    while y < height {
        var x = 0
        while x < width {
            let alpha = sample_alpha(blurred, width, height,
                x as float - offset.x, y as float - offset.y) * color.a
            result.append(color.r * alpha)
            result.append(color.g * alpha)
            result.append(color.b * alpha)
            result.append(alpha)
            x++
        }
        y++
    }
    composite_premultiplied(result, source)
    return result
}

func sample_alpha(values:@float[], width:int, height:int, x:float, y:float) float {
    let left = Math.floor(x) as int
    let top = Math.floor(y) as int
    let fraction_x = x - left as float
    let fraction_y = y - top as float
    let top_value = alpha_at(values, width, height, left, top) * (1.0 - fraction_x) +
        alpha_at(values, width, height, left + 1, top) * fraction_x
    let bottom_value = alpha_at(values, width, height, left, top + 1) * (1.0 - fraction_x) +
        alpha_at(values, width, height, left + 1, top + 1) * fraction_x
    return top_value * (1.0 - fraction_y) + bottom_value * fraction_y
}

func alpha_at(values:@float[], width:int, height:int, x:int, y:int) float {
    if x < 0 || y < 0 || x >= width || y >= height { return 0.0 }
    return values[(y * width + x) * 4 + 3]
}

// Composites `source` above `destination`, both premultiplied.
func composite_premultiplied(destination:&float[], source:@float[]) {
    var index = 0
    while index < destination.count() {
        let inverse = 1.0 - source[index + 3]
        destination[index] = source[index] + destination[index] * inverse
        destination[index + 1] = source[index + 1] + destination[index + 1] * inverse
        destination[index + 2] = source[index + 2] + destination[index + 2] * inverse
        destination[index + 3] = source[index + 3] + destination[index + 3] * inverse
        index += 4
    }
}

func composite_image(
    destination:uint,
    width:int,
    height:int,
    source:@Image,
    position:Math.Vec2
) {
    let pixels = source.packed_pixels()
    let address = C.address_bits(C.pointer(pixels))
    let origin_x = position.x as int
    let origin_y = position.y as int
    var source_y = 0
    while source_y < source.height() {
        let target_y = origin_y + source_y
        if target_y >= 0 && target_y < height {
            var source_x = 0
            while source_x < source.width() {
                let target_x = origin_x + source_x
                if target_x >= 0 && target_x < width {
                    let source_offset = (source_y * source.width() + source_x) * 4
                    let destination_offset = (target_y * width + target_x) * 4
                    let alpha = read_byte(address, source_offset + 3) as float / 255.0
                    if alpha > 0.0 {
                        blend(
                            destination,
                            destination_offset,
                            Color.rgba(
                                read_byte(address, source_offset) as float / 255.0,
                                read_byte(address, source_offset + 1) as float / 255.0,
                                read_byte(address, source_offset + 2) as float / 255.0,
                                alpha
                            ),
                            1.0
                        )
                    }
                }
                source_x++
            }
        }
        source_y++
    }
}

func measure_text(value:@str, style:@TextStyle) TextMetrics {
    if style.size <= 0.0 { panic("GFX.Canvas text size must be positive") }
    var font = style.typeface()
    if let advance = style.fixed_advance {
        return fixed_advance_metrics(
            value,
            advance,
            style,
            font
        )
    }
    return measure_font_text(value, style, font)
}

func draw_covered(
    address:uint,
    width:int,
    height:int,
    brush:Brush,
    coverage:Coverage,
    brush_origin:Math.Vec2
) {
    let bounds = coverage_bounds(coverage)
    let minimum_x = Math.max(0.0, Math.floor(bounds.minimum.x)) as int
    let minimum_y = Math.max(0.0, Math.floor(bounds.minimum.y)) as int
    let maximum_x = Math.min(width as float, Math.ceil(bounds.maximum.x)) as int
    let maximum_y = Math.min(height as float, Math.ceil(bounds.maximum.y)) as int
    var y = minimum_y
    while y < maximum_y {
        var x = minimum_x
        while x < maximum_x {
            let amount = shape_coverage(coverage, x, y)
            if amount > 0.0 {
                let color = brush.color_at(
                    Math.Vec2(x as float + 0.5, y as float + 0.5).add(brush_origin)
                )
                blend(address, (y * width + x) * 4, color, amount)
            }
            x++
        }
        y++
    }
}

func draw_fill_covered(
    address:uint,
    width:int,
    height:int,
    fill:Fill,
    coverage:Coverage,
    brush_origin:Math.Vec2
) {
    if !fill.is_image() {
        draw_covered(address, width, height, fill.brush(), coverage, brush_origin)
        return
    }
    let source = raster_image_fill(fill)
    let bounds = coverage_bounds(coverage)
    let minimum_x = Math.max(0.0, Math.floor(bounds.minimum.x)) as int
    let minimum_y = Math.max(0.0, Math.floor(bounds.minimum.y)) as int
    let maximum_x = Math.min(width as float, Math.ceil(bounds.maximum.x)) as int
    let maximum_y = Math.min(height as float, Math.ceil(bounds.maximum.y)) as int
    var y = minimum_y
    while y < maximum_y {
        var x = minimum_x
        while x < maximum_x {
            let amount = shape_coverage(coverage, x, y)
            if amount > 0.0 {
                let point = Math.Vec2(x as float + 0.5, y as float + 0.5)
                    .add(brush_origin)
                let color = image_color_at(source, point)
                blend(address, (y * width + x) * 4, color, amount)
            }
            x++
        }
        y++
    }
}

func shape_coverage(coverage:@Coverage, x:int, y:int) float {
    var covered = 0
    var sample_y = 0
    while sample_y < 4 {
        var sample_x = 0
        while sample_x < 4 {
            let point = Math.Vec2(
                x as float + (sample_x as float + 0.5) * 0.25,
                y as float + (sample_y as float + 0.5) * 0.25
            )
            if covers(coverage, point) { covered++ }
            sample_x++
        }
        sample_y++
    }
    return covered as float / 16.0
}

func coverage_bounds(coverage:@Coverage) Bounds {
    return match coverage {
        rect_fill(value) => Bounds(minimum:value.position, maximum:value.position.add(value.size))
        rect_stroke(value) => expanded_bounds(value.position, value.position.add(value.size), value.width * 0.5)
        circle_fill(value) => expanded_bounds(value.center, value.center, value.radius)
        circle_stroke(value) => expanded_bounds(value.center, value.center, value.radius + value.width * 0.5)
        line_stroke(value) => expanded_bounds(value.start.minimum(value.end), value.start.maximum(value.end), value.width * 0.5)
    }
}

func expanded_bounds(minimum:Math.Vec2, maximum:Math.Vec2, amount:float) Bounds {
    return Bounds(
        minimum:minimum.subtract(Math.Vec2(amount)),
        maximum:maximum.add(Math.Vec2(amount))
    )
}

func polyline_bounds(line:@Polyline, expansion:float) Bounds {
    if line.points.count() == 0 { return Bounds(minimum:Math.Vec2(), maximum:Math.Vec2()) }
    var minimum = line.points[0]
    var maximum = line.points[0]
    var index = 1
    while index < line.points.count() {
        minimum = minimum.minimum(line.points[index])
        maximum = maximum.maximum(line.points[index])
        index++
    }
    return expanded_bounds(minimum, maximum, expansion)
}

func covers(coverage:@Coverage, point:Math.Vec2) bool {
    return match coverage {
        rect_fill(value) => inside_rect(point, value.position, value.size, value.radius)
        rect_stroke(value) => inside_rect_stroke(point, value)
        circle_fill(value) => point.subtract(value.center).length_squared() <= value.radius * value.radius
        circle_stroke(value) => inside_circle_stroke(point, value)
        line_stroke(value) => segment_distance_squared(point, value.start, value.end) <= value.width * value.width * 0.25
    }
}

func draw_path(
    address:uint,
    width:int,
    height:int,
    brush:Brush,
    line:@Polyline,
    radius:float,
    filled:bool,
    brush_origin:Math.Vec2
) {
    if !filled {
        draw_stroked_path(address, width, height, brush, line, radius, brush_origin)
        return
    }
    let bounds = polyline_bounds(line, radius)
    let minimum_x = Math.max(0.0, Math.floor(bounds.minimum.x)) as int
    let minimum_y = Math.max(0.0, Math.floor(bounds.minimum.y)) as int
    let maximum_x = Math.min(width as float, Math.ceil(bounds.maximum.x)) as int
    let maximum_y = Math.min(height as float, Math.ceil(bounds.maximum.y)) as int
    var y = minimum_y
    while y < maximum_y {
        var x = minimum_x
        while x < maximum_x {
            let amount = path_coverage(line, x, y, radius, filled)
            if amount > 0.0 {
                let color = brush.color_at(
                    Math.Vec2(x as float + 0.5, y as float + 0.5).add(brush_origin)
                )
                blend(address, (y * width + x) * 4, color, amount)
            }
            x++
        }
        y++
    }
}

func draw_fill_path(
    address:uint,
    width:int,
    height:int,
    fill:Fill,
    line:@Polyline,
    brush_origin:Math.Vec2
) {
    if !fill.is_image() {
        draw_path(address, width, height, fill.brush(), line, 0.0, true, brush_origin)
        return
    }
    let source = raster_image_fill(fill)
    let bounds = polyline_bounds(line, 0.0)
    let minimum_x = Math.max(0.0, Math.floor(bounds.minimum.x)) as int
    let minimum_y = Math.max(0.0, Math.floor(bounds.minimum.y)) as int
    let maximum_x = Math.min(width as float, Math.ceil(bounds.maximum.x)) as int
    let maximum_y = Math.min(height as float, Math.ceil(bounds.maximum.y)) as int
    var y = minimum_y
    while y < maximum_y {
        var x = minimum_x
        while x < maximum_x {
            let amount = path_coverage(line, x, y, 0.0, true)
            if amount > 0.0 {
                let point = Math.Vec2(x as float + 0.5, y as float + 0.5)
                    .add(brush_origin)
                let color = image_color_at(source, point)
                blend(address, (y * width + x) * 4, color, amount)
            }
            x++
        }
        y++
    }
}

func raster_image_fill(fill:@Fill) RasterImageFill {
    var paint = fill.image_paint()
    let mapping = fill.image_mapping()
    let region = validate_image_mapping(paint, mapping)
    let image = paint.image()
    return RasterImageFill(
        pixels:image.pixels(),
        width:image.width(),
        height:image.height(),
        region:region,
        mapping:mapping
    )
}

func image_color_at(source:@RasterImageFill, point:Math.Vec2) Color {
    let mapping = source.mapping
    var coordinate = Math.Vec2()
    if mapping.kind() == ImageMappingKind.tile {
        coordinate = point.subtract(mapping.origin()).divide(mapping.texel_size())
        if mapping.sampling() == ImageSampling.pixelated {
            return image_texel(
                source,
                wrapped(Math.floor(coordinate.x) as int, source.region.width),
                wrapped(Math.floor(coordinate.y) as int, source.region.height)
            )
        }
        return smooth_tile(source, coordinate)
    }

    let frame = mapping.frame()
    if !inside_half_open(point, frame.position, frame.size) {
        return Color.transparent()
    }
    var destination_origin = frame.position
    var destination_size = frame.size
    if mapping.mode() != ImageFit.stretch {
        let source_size = Math.Vec2(
            source.region.width as float,
            source.region.height as float
        )
        let scale_x = frame.size.x / source_size.x
        let scale_y = frame.size.y / source_size.y
        var scale = Math.min(scale_x, scale_y)
        if mapping.mode() == ImageFit.cover { scale = Math.max(scale_x, scale_y) }
        destination_size = source_size.multiply(scale)
        destination_origin = frame.position.add(
            frame.size.subtract(destination_size).multiply(mapping.alignment())
        )
        if mapping.mode() == ImageFit.contain &&
            !inside_half_open(point, destination_origin, destination_size)
        {
            return Color.transparent()
        }
    }
    coordinate = point.subtract(destination_origin).divide(destination_size)
    if mapping.sampling() == ImageSampling.pixelated {
        var x = Math.floor(coordinate.x * source.region.width as float) as int
        var y = Math.floor(coordinate.y * source.region.height as float) as int
        if x >= source.region.width { x = source.region.width - 1 }
        if y >= source.region.height { y = source.region.height - 1 }
        return image_texel(source, x, y)
    }
    return smooth_fit(source, coordinate)
}

func inside_half_open(point:Math.Vec2, origin:Math.Vec2, size:Math.Vec2) bool {
    return point.x >= origin.x && point.y >= origin.y &&
        point.x < origin.x + size.x && point.y < origin.y + size.y
}

func wrapped(value:int, size:int) int {
    var result = value % size
    if result < 0 { result += size }
    return result
}

func image_texel(source:@RasterImageFill, x:int, y:int) Color {
    let selected_x = source.region.x + x
    let selected_y = source.region.y + y
    let offset = (selected_y * source.width + selected_x) * 4
    return Color.bytes(
        source.pixels[offset],
        source.pixels[offset + 1],
        source.pixels[offset + 2],
        source.pixels[offset + 3]
    )
}

func smooth_fit(source:@RasterImageFill, normalized:Math.Vec2) Color {
    let x = -0.5 + normalized.x * source.region.width as float
    let y = -0.5 + normalized.y * source.region.height as float
    let x0 = Math.floor(x) as int
    let y0 = Math.floor(y) as int
    let amount_x = x - x0 as float
    let amount_y = y - y0 as float
    let left = clamped_index(x0, source.region.width)
    let right = clamped_index(x0 + 1, source.region.width)
    let top = clamped_index(y0, source.region.height)
    let bottom = clamped_index(y0 + 1, source.region.height)
    return image_texel(source, left, top)
        .lerp(image_texel(source, right, top), amount_x)
        .lerp(
            image_texel(source, left, bottom)
                .lerp(image_texel(source, right, bottom), amount_x),
            amount_y
        )
}

func clamped_index(value:int, size:int) int {
    if value < 0 { return 0 }
    if value >= size { return size - 1 }
    return value
}

func smooth_tile(source:@RasterImageFill, coordinate:Math.Vec2) Color {
    let x = Math.modulo(coordinate.x, source.region.width as float) - 0.5
    let y = Math.modulo(coordinate.y, source.region.height as float) - 0.5
    let x0 = Math.floor(x) as int
    let y0 = Math.floor(y) as int
    let amount_x = x - x0 as float
    let amount_y = y - y0 as float
    return image_texel(source, wrapped(x0, source.region.width), wrapped(y0, source.region.height))
        .lerp(
            image_texel(source, wrapped(x0 + 1, source.region.width), wrapped(y0, source.region.height)),
            amount_x
        )
        .lerp(
            image_texel(source, wrapped(x0, source.region.width), wrapped(y0 + 1, source.region.height))
                .lerp(
                    image_texel(source, wrapped(x0 + 1, source.region.width), wrapped(y0 + 1, source.region.height)),
                    amount_x
                ),
            amount_y
        )
}

func draw_stroked_path(
    address:uint,
    width:int,
    height:int,
    brush:Brush,
    line:@Polyline,
    radius:float,
    brush_origin:Math.Vec2
) {
    if line.points.count() < 2 { return }
    var samples = packed_storage(width * height * 2)
    let samples_address = C.address_bits(C.mutable_string_pointer(samples))
    var segment_index = 1
    while segment_index < line.points.count() {
        let start = line.points[segment_index - 1]
        let end = line.points[segment_index]
        let minimum_x = Math.max(0.0, Math.floor(Math.min(start.x, end.x) - radius)) as int
        let minimum_y = Math.max(0.0, Math.floor(Math.min(start.y, end.y) - radius)) as int
        let maximum_x = Math.min(width as float, Math.ceil(Math.max(start.x, end.x) + radius)) as int
        let maximum_y = Math.min(height as float, Math.ceil(Math.max(start.y, end.y) + radius)) as int
        var y = minimum_y
        while y < maximum_y {
            var x = minimum_x
            while x < maximum_x {
                let sample_offset = (y * width + x) * 2
                var covered = C.load<uint16>(samples_address, sample_offset as uint)
                var sample_y = 0
                while sample_y < 4 {
                    var sample_x = 0
                    while sample_x < 4 {
                        let sample_index = sample_y * 4 + sample_x
                        let bit = (1 as uint16) << sample_index
                        if (covered & bit) == 0 && segment_distance_squared(
                            Math.Vec2(
                                x as float + (sample_x as float + 0.5) * 0.25,
                                y as float + (sample_y as float + 0.5) * 0.25
                            ),
                            start,
                            end
                        ) <= radius * radius {
                            covered = covered ^ bit
                        }
                        sample_x++
                    }
                    sample_y++
                }
                let stored = C.store<uint16>(samples_address, sample_offset as uint, covered)
                x++
            }
            y++
        }
        segment_index++
    }

    let bounds = polyline_bounds(line, radius)
    let minimum_x = Math.max(0.0, Math.floor(bounds.minimum.x)) as int
    let minimum_y = Math.max(0.0, Math.floor(bounds.minimum.y)) as int
    let maximum_x = Math.min(width as float, Math.ceil(bounds.maximum.x)) as int
    let maximum_y = Math.min(height as float, Math.ceil(bounds.maximum.y)) as int
    var y = minimum_y
    while y < maximum_y {
        var x = minimum_x
        while x < maximum_x {
            let covered = C.load<uint16>(samples_address, ((y * width + x) * 2) as uint)
            if covered != 0 {
                var count = 0
                var sample_index = 0
                while sample_index < 16 {
                    if (covered & ((1 as uint16) << sample_index)) != 0 { count++ }
                    sample_index++
                }
                let color = brush.color_at(
                    Math.Vec2(x as float + 0.5, y as float + 0.5).add(brush_origin)
                )
                blend(address, (y * width + x) * 4, color, count as float / 16.0)
            }
            x++
        }
        y++
    }
}

func path_coverage(line:@Polyline, x:int, y:int, radius:float, filled:bool) float {
    var covered = 0
    var sample_y = 0
    while sample_y < 4 {
        var sample_x = 0
        while sample_x < 4 {
            let point = Math.Vec2(
                x as float + (sample_x as float + 0.5) * 0.25,
                y as float + (sample_y as float + 0.5) * 0.25
            )
            if path_covers(line, point, radius, filled) { covered++ }
            sample_x++
        }
        sample_y++
    }
    return covered as float / 16.0
}

func path_covers(line:@Polyline, point:Math.Vec2, radius:float, filled:bool) bool {
    if filled { return inside_polygon(point, line.points) }
    return near_polyline(point, line, radius)
}

func inside_circle_stroke(point:Math.Vec2, value:CircleStrokeCoverage) bool {
    let half = value.width * 0.5
    let distance_squared = point.subtract(value.center).length_squared()
    let inner = Math.max(0.0, value.radius - half)
    let outer = value.radius + half
    return distance_squared >= inner * inner && distance_squared <= outer * outer
}

func inside_rect_stroke(point:Math.Vec2, value:RectStrokeCoverage) bool {
    let half = value.width * 0.5
    let outer_position = value.position.subtract(Math.Vec2(half))
    let outer_size = value.size.add(Math.Vec2(value.width))
    let outer = inside_rect(point, outer_position, outer_size, value.radius + half)
    let inner_position = value.position.add(Math.Vec2(half))
    let inner_size = value.size.subtract(Math.Vec2(value.width))
    if inner_size.x <= 0.0 || inner_size.y <= 0.0 { return outer }
    return outer && !inside_rect(point, inner_position, inner_size, Math.max(0.0, value.radius - half))
}

func inside_rect(point:Math.Vec2, position:Math.Vec2, size:Math.Vec2, radius:float) bool {
    if point.x < position.x || point.y < position.y ||
        point.x > position.x + size.x || point.y > position.y + size.y { return false }
    let rounded = Math.min(Math.max(0.0, radius), Math.min(size.x, size.y) * 0.5)
    if rounded <= 0.0 { return true }
    let inner_left = position.x + rounded
    let inner_right = position.x + size.x - rounded
    let inner_top = position.y + rounded
    let inner_bottom = position.y + size.y - rounded
    if point.x >= inner_left && point.x <= inner_right { return true }
    if point.y >= inner_top && point.y <= inner_bottom { return true }
    var center_x = inner_right
    var center_y = inner_bottom
    if point.x < inner_left { center_x = inner_left }
    if point.y < inner_top { center_y = inner_top }
    let center = Math.Vec2(center_x, center_y)
    return point.distance(center) <= rounded
}

func segment_distance_squared(point:Math.Vec2, start:Math.Vec2, end:Math.Vec2) float {
    let segment_x = end.x - start.x
    let segment_y = end.y - start.y
    let length = segment_x * segment_x + segment_y * segment_y
    let offset_x = point.x - start.x
    let offset_y = point.y - start.y
    if length <= 0.0 { return offset_x * offset_x + offset_y * offset_y }
    let amount = Math.clamp(
        (offset_x * segment_x + offset_y * segment_y) / length,
        0.0,
        1.0
    )
    let distance_x = point.x - (start.x + segment_x * amount)
    let distance_y = point.y - (start.y + segment_y * amount)
    return distance_x * distance_x + distance_y * distance_y
}

func curve_midpoint(a:Math.Vec2, b:Math.Vec2) Math.Vec2 {
    return Math.Vec2((a.x + b.x) * 0.5, (a.y + b.y) * 0.5)
}

func round_curve_segments(radius:float, sweep:float) int {
    let tolerance = 0.05
    let cosine = Math.clamp(1.0 - tolerance / radius, -1.0, 1.0)
    let maximum_step = 2.0 * Math.acos(cosine)
    let required = Math.ceil(Math.abs(sweep) / maximum_step)
    return Math.max(8.0, Math.min(512.0, required)) as int
}

func append_flattened_quadratic(
    points:&Math.Vec2[],
    start:Math.Vec2,
    control:Math.Vec2,
    end:Math.Vec2,
    depth:int
) {
    let tolerance_squared = 0.04
    if depth >= 12 || segment_distance_squared(control, start, end) <= tolerance_squared {
        points.append(end)
        return
    }
    let start_control = curve_midpoint(start, control)
    let control_end = curve_midpoint(control, end)
    let split = curve_midpoint(start_control, control_end)
    append_flattened_quadratic(points, start, start_control, split, depth + 1)
    append_flattened_quadratic(points, split, control_end, end, depth + 1)
}

func append_flattened_cubic(
    points:&Math.Vec2[],
    start:Math.Vec2,
    control_a:Math.Vec2,
    control_b:Math.Vec2,
    end:Math.Vec2,
    depth:int
) {
    let tolerance_squared = 0.04
    let control_a_distance = segment_distance_squared(control_a, start, end)
    let control_b_distance = segment_distance_squared(control_b, start, end)
    if depth >= 12 || Math.max(control_a_distance, control_b_distance) <= tolerance_squared {
        points.append(end)
        return
    }
    let start_a = curve_midpoint(start, control_a)
    let a_b = curve_midpoint(control_a, control_b)
    let b_end = curve_midpoint(control_b, end)
    let left_control = curve_midpoint(start_a, a_b)
    let right_control = curve_midpoint(a_b, b_end)
    let split = curve_midpoint(left_control, right_control)
    append_flattened_cubic(points, start, start_a, left_control, split, depth + 1)
    append_flattened_cubic(points, split, right_control, b_end, end, depth + 1)
}

func flatten(path:Path) Polyline {
    var points:Math.Vec2[] = []
    var current = Math.Vec2()
    var first = Math.Vec2()
    var has_current = false
    var closed = false
    for step in path.steps() {
        match step {
            moved(point) => {
                current = point
                first = point
                has_current = true
                points.append(point)
            }
            lined(point) => {
                if !has_current { first = point; has_current = true }
                current = point
                points.append(point)
            }
            quadratic(curve) => {
                if !has_current { current = curve.end; first = curve.end; has_current = true; points.append(curve.end) }
                else {
                    let start = current
                    append_flattened_quadratic(points, start, curve.control, curve.end, 0)
                    current = curve.end
                }
            }
            cubic(curve) => {
                if !has_current { current = curve.end; first = curve.end; has_current = true; points.append(curve.end) }
                else {
                    let start = current
                    append_flattened_cubic(
                        points,
                        start,
                        curve.control_a,
                        curve.control_b,
                        curve.end,
                        0
                    )
                    current = curve.end
                }
            }
            arc(curve) => {
                let segments = round_curve_segments(curve.radius, curve.sweep)
                var index = 1
                while index <= segments {
                    let angle = curve.start + curve.sweep * index as float / segments as float
                    let point = curve.center.add(Math.Vec2(
                        Math.cos(angle) * curve.radius,
                        Math.sin(angle) * curve.radius
                    ))
                    points.append(point)
                    current = point
                    index++
                }
            }
            close => {
                if has_current && current.distance(first) > 0.0 { points.append(first) }
                current = first
                closed = true
            }
        }
    }
    return Polyline(points:points, closed:closed)
}

func inside_polygon(point:Math.Vec2, points:@Math.Vec2[]) bool {
    if points.count() < 3 { return false }
    var inside = false
    var previous = points.count() - 1
    var index = 0
    while index < points.count() {
        let a = points[index]
        let b = points[previous]
        if (a.y > point.y) != (b.y > point.y) &&
            point.x < (b.x - a.x) * (point.y - a.y) / (b.y - a.y) + a.x { inside = !inside }
        previous = index
        index++
    }
    return inside
}

func near_polyline(point:Math.Vec2, line:@Polyline, radius:float) bool {
    let radius_squared = radius * radius
    var index = 1
    while index < line.points.count() {
        let start = line.points[index - 1]
        let end = line.points[index]
        if point.x >= Math.min(start.x, end.x) - radius &&
            point.x <= Math.max(start.x, end.x) + radius &&
            point.y >= Math.min(start.y, end.y) - radius &&
            point.y <= Math.max(start.y, end.y) + radius &&
            segment_distance_squared(point, start, end) <= radius_squared
        {
            return true
        }
        index++
    }
    if line.closed && line.points.count() > 2 {
        return segment_distance_squared(point, line.points[line.points.count() - 1], line.points[0]) <= radius_squared
    }
    return false
}

func measure_font_text(value:@str, style:@TextStyle, font:Font) TextMetrics {
    let owned_value = copied_text(value)
    var variations:VectorFont.Variation[] = []
    for variation in style.variations { variations.append(variation) }
    var instance = font.instance(
        style.size,
        font_weight_key(style.weight),
        variations
    )
    if cached = font.cached_metrics(instance, owned_value) {
        return TextMetrics(width:cached.width, height:cached.height, lines:cached.lines)
    }
    let lines = StandardText.split(owned_value, "\n")
    var width = 0.0
    for line in lines {
        var run = shaped(instance, line)
        var line_width = Math.ceil(run.metrics().advance.x) as int as float
        if instance.synthesis().embolden { line_width += 1.0 }
        width = Math.max(width, line_width)
    }
    var line_height = Math.ceil(instance.metrics().line_height) as int as float
    if let explicit = style.line_height { line_height = explicit }
    let metrics = TextMetrics(
        width:width,
        height:line_height * lines.count() as float,
        lines:lines.count()
    )
    font.retain_metrics(instance, owned_value, CachedTextMetrics(
        width:metrics.width,
        height:metrics.height,
        lines:metrics.lines
    ))
    return metrics
}

func draw_font_text(
    address:uint,
    width:int,
    height:int,
    value:str,
    position:Math.Vec2,
    style:TextStyle,
    font:Font,
    density:float,
    clip:Rect? = null
) {
    if value == "" { return }
    if let advance = style.fixed_advance {
        draw_fixed_advance_text(
            address,
            width,
            height,
            value,
            position,
            style,
            font,
            advance,
            density,
            clip
        )
        return
    }
    let metrics = measure_font_text(value, style, font)
    var origin_x = position.x
    if style.alignment == TextAlignment.center { origin_x -= metrics.width * density * 0.5 }
    if style.alignment == TextAlignment.end { origin_x -= metrics.width * density }
    var instance = font.instance(
        style.size,
        font_weight_key(style.weight),
        style.variations
    )
    var line_height = Math.ceil(instance.metrics().line_height) as int as float
    if let explicit = style.line_height { line_height = explicit }
    line_height *= density
    let lines = StandardText.split(value, "\n")
    var line_index = 0
    while line_index < lines.count() {
        var run = shaped(instance, lines[line_index])
        draw_glyph_run(
            address,
            width,
            height,
            run,
            font,
            origin_x,
            position.y + line_index as float * line_height,
            style.color,
            density,
            clip
        )
        line_index++
    }
}

func draw_text_raster(
    address:uint,
    width:int,
    height:int,
    raster:TextRaster,
    destination_x:int,
    destination_y:int,
    color_value:Color,
    clip:Rect? = null
) {
    let source = C.address_bits(C.pointer(raster.alpha))
    let red = color_channel(color_value.r)
    let green = color_channel(color_value.g)
    let blue = color_channel(color_value.b)
    let color_alpha = color_channel(color_value.a)
    let target_left = destination_x + raster.offset_x
    let target_top = destination_y + raster.offset_y
    var clip_left = 0
    var clip_top = 0
    var clip_right = width
    var clip_bottom = height
    if let bounds = clip {
        clip_left = Math.max(0.0, Math.ceil(bounds.position.x)) as int
        clip_top = Math.max(0.0, Math.ceil(bounds.position.y)) as int
        clip_right = Math.min(
            width as float,
            Math.floor(bounds.position.x + bounds.size.x)
        ) as int
        clip_bottom = Math.min(
            height as float,
            Math.floor(bounds.position.y + bounds.size.y)
        ) as int
    }
    let source_left = max_int(0, clip_left - target_left)
    let source_top = max_int(0, clip_top - target_top)
    let source_right = min_int(raster.width, clip_right - target_left)
    let source_bottom = min_int(raster.height, clip_bottom - target_top)
    if source_left >= source_right || source_top >= source_bottom { return }
    var source_y = source_top
    while source_y < source_bottom {
        let source_row = source_y * raster.width
        var target_offset = ((target_top + source_y) * width + target_left + source_left) * 4
        var source_x = source_left
        while source_x < source_right {
            let alpha = C.load<uint8>(source, (source_row + source_x) as uint)
            if alpha > 0 {
                blend_text_pixel(
                    address,
                    target_offset,
                    red,
                    green,
                    blue,
                    color_alpha,
                    alpha
                )
            }
            target_offset += 4
            source_x++
        }
        source_y++
    }
}

// A retained text image contains one monochrome command. Overlapping glyph
// coverage therefore changes only alpha; recomputing three identical color
// channels with the general RGBA blender wastes most of the composition cost.
func blend_text_pixel(
    address:uint,
    offset:int,
    red:uint8,
    green:uint8,
    blue:uint8,
    color_alpha:uint8,
    coverage:uint8
) {
    let destination_alpha = read_byte(address, offset + 3)
    if destination_alpha > 0 {
        let destination_red = read_byte(address, offset)
        let destination_green = read_byte(address, offset + 1)
        let destination_blue = read_byte(address, offset + 2)
        if destination_red != red || destination_green != green || destination_blue != blue {
            let source_alpha = color_alpha as float / 255.0 * coverage as float / 255.0
            let destination_amount = destination_alpha as float / 255.0
            let output_alpha = source_alpha + destination_amount * (1.0 - source_alpha)
            write_byte(address, offset, color_channel((
                red as float / 255.0 * source_alpha +
                destination_red as float / 255.0 * destination_amount * (1.0 - source_alpha)
            ) / output_alpha))
            write_byte(address, offset + 1, color_channel((
                green as float / 255.0 * source_alpha +
                destination_green as float / 255.0 * destination_amount * (1.0 - source_alpha)
            ) / output_alpha))
            write_byte(address, offset + 2, color_channel((
                blue as float / 255.0 * source_alpha +
                destination_blue as float / 255.0 * destination_amount * (1.0 - source_alpha)
            ) / output_alpha))
            write_byte(address, offset + 3, color_channel(output_alpha))
            return
        }
    }
    let source_product = color_alpha as int * coverage as int
    let output_alpha = (
        source_product * 255 +
        destination_alpha as int * (65025 - source_product) +
        32512
    ) / 65025
    if destination_alpha == 0 {
        write_byte(address, offset, red)
        write_byte(address, offset + 1, green)
        write_byte(address, offset + 2, blue)
    }
    write_byte(address, offset + 3, output_alpha as uint8)
}

func fixed_advance_metrics(
    value:@str,
    advance:float,
    style:@TextStyle,
    font:Font
) TextMetrics {
    let owned_value = copied_text(value)
    var variations:VectorFont.Variation[] = []
    for variation in style.variations { variations.append(variation) }
    var instance = font.instance(
        style.size,
        font_weight_key(style.weight),
        variations
    )
    var columns = 0
    var maximum_columns = 0
    var lines = 1
    for cluster in Grapheme.split(owned_value) {
        if cluster == "\n" {
            maximum_columns = max_int(maximum_columns, columns)
            columns = 0
            lines++
        } else { columns++ }
    }
    maximum_columns = max_int(maximum_columns, columns)
    var line_height = Math.ceil(instance.metrics().line_height) as int as float
    if let explicit = style.line_height { line_height = explicit }
    return TextMetrics(
        width:maximum_columns as float * advance,
        height:line_height * lines as float,
        lines:lines
    )
}

func copied_text(value:@str) str { return value }

func draw_fixed_advance_text(
    address:uint,
    width:int,
    height:int,
    value:str,
    position:Math.Vec2,
    style:TextStyle,
    font:Font,
    advance:float,
    density:float,
    clip:Rect? = null
) {
    let metrics = fixed_advance_metrics(
        value,
        advance,
        style,
        font
    )
    var origin_x = position.x
    if style.alignment == TextAlignment.center { origin_x -= metrics.width * density * 0.5 }
    if style.alignment == TextAlignment.end { origin_x -= metrics.width * density }
    var instance = font.instance(
        style.size,
        font_weight_key(style.weight),
        style.variations
    )
    var line_height = Math.ceil(instance.metrics().line_height) as int as float
    if let explicit = style.line_height { line_height = explicit }
    line_height *= density
    let lines = StandardText.split(value, "\n")
    var line_index = 0
    while line_index < lines.count() {
        var run = fixed_grid_run(instance, lines[line_index], advance)
        draw_glyph_run(
            address,
            width,
            height,
            run,
            font,
            origin_x,
            position.y + line_index as float * line_height,
            style.color,
            density:density,
            clip:clip
        )
        line_index++
    }
}

func max_int(first:int, second:int) int {
    if first > second { return first }
    return second
}

func min_int(first:int, second:int) int {
    if first < second { return first }
    return second
}

func shaped(
    instance:VectorFont.Instance,
    value:str,
    options:VectorFont.ShapeOptions = VectorFont.ShapeOptions()
) VectorFont.GlyphRun {
    match instance.shape(value, options) {
        failure(error) => { panic("GFX.Canvas could not shape text: " + error.detail) }
        success(run) => { return run }
    }
}

func fixed_grid_run(
    instance:VectorFont.Instance,
    value:str,
    advance:float
) VectorFont.GlyphRun {
    var starts:int[] = []
    var origins:VectorFont.Position[] = []
    var byte_offset = 0
    var column = 0
    for cluster in Grapheme.split(value) {
        starts.append(byte_offset)
        origins.append(VectorFont.Position(
            x:column as float64 * advance as float64,
            y:0.0
        ))
        byte_offset += C.byte_count(cluster) as int
        column++
    }
    var run = shaped(instance, value, VectorFont.ShapeOptions(features:[
        VectorFont.Feature("liga", 0),
        VectorFont.Feature("clig", 0),
        VectorFont.Feature("calt", 0),
        VectorFont.Feature("kern", 0)
    ]))
    match run.place_clusters(
        starts,
        origins,
        VectorFont.Position(x:column as float64 * advance as float64, y:0.0)
    ) {
        failure(error) => { panic("GFX.Canvas could not place fixed-grid text: " + error.detail) }
        success(placed) => { return placed }
    }
}

func draw_glyph_run(
    address:uint,
    width:int,
    height:int,
    run:VectorFont.GlyphRun,
    font:Font,
    position_x:float,
    position_y:float,
    color:Color,
    density:float = 1.0,
    clip:Rect? = null
) {
    var retained_run = run
    var instance = retained_run.instance()
    let baseline = Math.ceil(instance.metrics().ascender * density as float64) as int
    for glyph in retained_run.glyphs() {
        let raster = rasterized_glyph(instance, glyph.id, font, density)
        if raster.width == 0 || raster.height == 0 { continue }
        draw_text_raster(
            address,
            width,
            height,
            raster,
            Math.floor(position_x) as int + Math.round(glyph.origin_x * density as float64) as int,
            Math.floor(position_y) as int + baseline -
                Math.round(glyph.origin_y * density as float64) as int,
            color,
            clip
        )
        if instance.synthesis().embolden {
            draw_text_raster(
                address,
                width,
                height,
                raster,
                Math.floor(position_x) as int + Math.round(glyph.origin_x * density as float64) as int +
                    Math.max(1.0, Math.round(density)) as int,
                Math.floor(position_y) as int + baseline -
                    Math.round(glyph.origin_y * density as float64) as int,
                color,
                clip
            )
        }
    }
}

module func rasterized_glyph(
    instance:VectorFont.Instance,
    glyph_id:uint32,
    font:Font,
    density:float
) TextRaster {
    var retained_instance = instance
    if cached = font.cached_raster(retained_instance, glyph_id, density) { return cached }
    match retained_instance.rasterize_glyph(glyph_id, VectorFont.GlyphRasterOptions(
        density:density as float64,
        hinting:VectorFont.Hinting.normal(),
        antialiasing:VectorFont.Antialiasing.grayscale()
    )) {
        failure(error) => { panic("GFX.Canvas could not rasterize glyph $(glyph_id): " + error.detail) }
        success(coverage) => {
            var raster = TextRaster(width:0, height:0, alpha:"", offset_x:0, offset_y:0)
            if value = coverage {
                raster = TextRaster(
                    width:value.width,
                    height:value.height,
                    alpha:value.packed_alpha(),
                    offset_x:value.left,
                    offset_y:-value.top
                )
            }
            font.retain_raster(retained_instance, glyph_id, density, raster)
            return raster
        }
    }
}

func font_weight_key(weight:TextWeight) int {
    if weight == TextWeight.bold { return 1 }
    return 0
}

func draw_text(
    address:uint,
    width:int,
    height:int,
    value:str,
    position:Math.Vec2,
    style:TextStyle,
    density:float = 1.0,
    clip:Rect? = null
) {
    draw_font_text(
        address,
        width,
        height,
        value,
        position,
        style,
        style.typeface(),
        density,
        clip
    )
}

func blend(address:uint, offset:int, color:Color, coverage:float) {
    let source_alpha = Math.clamp(color.a * coverage, 0.0, 1.0)
    let destination_alpha = read_byte(address, offset + 3) as float / 255.0
    let output_alpha = source_alpha + destination_alpha * (1.0 - source_alpha)
    if output_alpha <= 0.0 {
        write_byte(address, offset, 0); write_byte(address, offset + 1, 0)
        write_byte(address, offset + 2, 0); write_byte(address, offset + 3, 0)
        return
    }
    write_byte(address, offset, color_channel((color.r * source_alpha + read_byte(address, offset) as float / 255.0 * destination_alpha * (1.0 - source_alpha)) / output_alpha))
    write_byte(address, offset + 1, color_channel((color.g * source_alpha + read_byte(address, offset + 1) as float / 255.0 * destination_alpha * (1.0 - source_alpha)) / output_alpha))
    write_byte(address, offset + 2, color_channel((color.b * source_alpha + read_byte(address, offset + 2) as float / 255.0 * destination_alpha * (1.0 - source_alpha)) / output_alpha))
    write_byte(address, offset + 3, color_channel(output_alpha))
}

func read_byte(address:uint, offset:int) uint8 {
    return C.load<uint8>(address, offset as uint)
}

func write_byte(address:uint, offset:int, value:uint8) {
    let stored = C.store<uint8>(address, offset as uint, value)
}

func color_channel(value:float) uint8 {
    return Math.round(Math.clamp(value, 0.0, 1.0) * 255.0) as uint8
}
