use GFX.Color
use GFX.Canvas.Canvas.Canvas
use GFX.Canvas.Canvas.Painter
use GFX.Canvas.Prepared.Prepared
use GFX.Canvas.Shapes.Circle
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Path.Path
use GFX.Canvas.Styles.Fill
use GFX.Canvas.Styles.Stroke
use GFX.Canvas.Styles.TextAlignment
use GFX.Canvas.Styles.TextStyle
use GFX.Canvas.Font.Font
use GFX.Canvas.Effects.Effect
use GFX.Canvas.TextBlock.TextBlock
use STD.Math

test "paint and clear a canvas without SDL or a renderer" {
    var canvas = Canvas()
    canvas.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(20.0, 10.0)),
            Fill.solid(Color.red_500())
        )
        painter.stroke(
            Circle(Math.Vec2(10.0), 4.0),
            Stroke(Color.white(), 2.0)
        )
    })

    var commands = canvas.commands()
    assert(commands.count() == 2)
    assert(canvas.revision() == 3)
    canvas.clear()
    assert(canvas.is_empty())
    assert(canvas.revision() == 4)
}

test "report final logical bounds after portable effects" {
    var canvas = Canvas()
    canvas.paint(func(painter:&Painter) {
        painter.layer([
            Effect.shadow(Math.Vec2(6.0, 4.0), 3.0, Color.black())
        ], func(layer:&Painter) {
            layer.fill(
                Rect(Math.Vec2(10.0, 12.0), Math.Vec2(20.0, 8.0)),
                Fill.solid(Color.white())
            )
        })
    })
    if let bounds = canvas.bounds() {
        assert(bounds.position == Math.Vec2(10.0, 12.0))
        assert(bounds.size == Math.Vec2(29.0, 15.0))
    } else {
        assert(false)
    }
    canvas.clear()
    assert(canvas.bounds() == null)
}

test "reuse retained ordered content across unchanged prepared reads" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.layer([Effect.blur(3.0)], func(layer:&Painter) {
            layer.fill(
                Rect(Math.Vec2(2.0), Math.Vec2(12.0, 8.0)),
                Fill.solid(Color.cyan_400())
            )
        })
    })
    var prepared = drawing.prepared(32, 24)
    var first = prepared.content()
    var second = prepared.content()
    assert(first.count() == 1)
    assert(second.count() == 1)
    match first[0] {
        layer(left) => {
            match second[0] {
                layer(right) => { assert(left == right) }
                else => { assert(false) }
            }
        }
        else => { assert(false) }
    }
}

test "retain unchanged sibling layer identities and revisions" {
    var canvas = Canvas()
    canvas.paint(func(painter:&Painter) {
        painter.layer([Effect.opacity(0.8)], func(layer:&Painter) {
            layer.fill(Rect(Math.Vec2(2.0), Math.Vec2(8.0)), Fill.solid(Color.red_500()))
        })
        painter.layer([Effect.blur(2.0)], func(layer:&Painter) {
            layer.fill(Rect(Math.Vec2(16.0, 2.0), Math.Vec2(8.0)), Fill.solid(Color.blue_500()))
        })
    })
    var before = canvas.commands()
    var first_id = 0
    var first_revision = 0
    var second_id = 0
    var second_revision = 0
    match before[0] { layer(value) => { first_id = value.id(); first_revision = value.revision() }; else => {} }
    match before[1] { layer(value) => { second_id = value.id(); second_revision = value.revision() }; else => {} }

    canvas.clear()
    canvas.paint(func(painter:&Painter) {
        painter.layer([Effect.opacity(0.8)], func(layer:&Painter) {
            layer.fill(Rect(Math.Vec2(2.0), Math.Vec2(8.0)), Fill.solid(Color.red_500()))
        })
        painter.layer([Effect.blur(3.0)], func(layer:&Painter) {
            layer.fill(Rect(Math.Vec2(16.0, 2.0), Math.Vec2(8.0)), Fill.solid(Color.blue_500()))
        })
    })
    var after = canvas.commands()
    match after[0] {
        layer(value) => {
            assert(value.id() == first_id)
            assert(value.revision() == first_revision)
        }
        else => { assert(false) }
    }
    match after[1] {
        layer(value) => {
            assert(value.id() == second_id)
            assert(value.revision() == second_revision + 1)
        }
        else => { assert(false) }
    }
}

test "reuse cached text while vector geometry changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(8.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var previous = first.snapshot(160, 40)
    let first_text = previous.text_layer(2.0)
    assert(previous.has_cached_text())

    var changed_geometry = Canvas()
    changed_geometry.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(16.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var reused = changed_geometry.snapshot(160, 40, reuse:previous)
    assert(reused.has_cached_text())
    assert(reused.geometry_revision() != previous.geometry_revision())
    assert(reused.text_revision() == previous.text_revision())

    var changed_text = Canvas()
    changed_text.paint(func(painter:&Painter) {
        painter.text("Changed label", Math.Vec2(4.0, 4.0))
    })
    var invalidated = changed_text.snapshot(160, 40, reuse:reused)
    assert(!invalidated.has_cached_text())
    assert(invalidated.text_revision() != reused.text_revision())
}

test "retain unchanged text layers while one label changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("50%", Math.Vec2(2.0, 20.0))
    })
    var previous = first.snapshot(120, 40)
    var previous_layers = previous.text_layers()
    assert(previous_layers.count() == 2)
    let static_revision = previous_layers[0].revision()
    let value_revision = previous_layers[1].revision()

    var changed = Canvas()
    changed.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("51%", Math.Vec2(2.0, 20.0))
    })
    var retained = changed.snapshot(120, 40, reuse:previous)
    var retained_layers = retained.text_layers()
    assert(retained_layers.count() == 2)
    assert(retained.geometry_revision() == previous.geometry_revision())
    assert(retained_layers[0].id() == previous_layers[0].id())
    assert(retained_layers[0].revision() == static_revision)
    assert(retained_layers[1].id() == previous_layers[1].id())
    assert(retained_layers[1].revision() == value_revision + 1)
}

test "reuse cached line pixels when a retained text list scrolls" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Alpha", Math.Vec2(4.0, 2.0))
        painter.text("Beta", Math.Vec2(4.0, 20.0))
        painter.text("Gamma", Math.Vec2(4.0, 38.0))
    })
    var previous = first.snapshot(120, 60)
    var old_layers = previous.text_layers()
    let old_beta = old_layers[1].text_layer(2.0)
    let old_gamma = old_layers[2].text_layer(2.0)

    var scrolled = Canvas()
    scrolled.paint(func(painter:&Painter) {
        painter.text("Beta", Math.Vec2(4.0, 2.0))
        painter.text("Gamma", Math.Vec2(4.0, 20.0))
        painter.text("Delta", Math.Vec2(4.0, 38.0))
    })
    var reused = scrolled.snapshot(120, 60, reuse:previous)
    var moved_layers = reused.text_layers()
    let moved_beta = moved_layers[0].text_layer(2.0)
    let moved_gamma = moved_layers[1].text_layer(2.0)
    assert(moved_layers[0].id() == old_layers[1].id())
    assert(moved_layers[1].id() == old_layers[2].id())
    assert(moved_beta.image.packed_pixels() == old_beta.image.packed_pixels())
    assert(moved_gamma.image.packed_pixels() == old_gamma.image.packed_pixels())
    assert(moved_beta.origin.y == old_beta.origin.y - 18.0)
    assert(moved_gamma.origin.y == old_gamma.origin.y - 18.0)

    var fresh = scrolled.snapshot(120, 60)
    var fresh_layers = fresh.text_layers()
    let fresh_beta = fresh_layers[0].text_layer(2.0)
    let fresh_gamma = fresh_layers[1].text_layer(2.0)
    assert(moved_beta.image.packed_pixels() == fresh_beta.image.packed_pixels())
    assert(moved_gamma.image.packed_pixels() == fresh_gamma.image.packed_pixels())
    assert(moved_beta.origin == fresh_beta.origin)
    assert(moved_gamma.origin == fresh_gamma.origin)
}

test "reuse shaped atlas runs when a retained text list scrolls" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Alpha", Math.Vec2(4.0, 2.0))
        painter.text("Beta", Math.Vec2(4.0, 20.0))
        painter.text("Gamma", Math.Vec2(4.0, 38.0))
    })
    var previous = first.snapshot(120, 60)
    var old_layers = previous.text_layers()
    var old_beta_run = old_layers[1].glyph_run()
    var old_gamma_run = old_layers[2].glyph_run()

    var scrolled = Canvas()
    scrolled.paint(func(painter:&Painter) {
        painter.text("Beta", Math.Vec2(4.0, 2.0))
        painter.text("Gamma", Math.Vec2(4.0, 20.0))
        painter.text("Delta", Math.Vec2(4.0, 38.0))
    })
    var reused = scrolled.snapshot(120, 60, reuse:previous)
    var moved_layers = reused.text_layers()
    var moved_beta_run = moved_layers[0].glyph_run()
    var moved_gamma_run = moved_layers[1].glyph_run()
    assert(moved_layers[0].id() == old_layers[1].id())
    assert(moved_layers[1].id() == old_layers[2].id())
    assert(moved_layers[0].shaping_revision() == old_layers[1].shaping_revision())
    assert(moved_layers[1].shaping_revision() == old_layers[2].shaping_revision())
    assert(moved_beta_run.glyphs() == old_beta_run.glyphs())
    assert(moved_gamma_run.glyphs() == old_gamma_run.glyphs())
}

test "reuse shaping when only text color changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Stable shaping", Math.Vec2(2.0), TextStyle(
            size:14.0,
            color:Color.cyan_500()
        ))
    })
    var previous = first.snapshot(160, 32)
    var previous_layer = previous.text_layers()[0]
    var first_run = previous_layer.glyph_run()
    let shaping_revision = previous_layer.shaping_revision()

    var recolored = Canvas()
    recolored.paint(func(painter:&Painter) {
        painter.text("Stable shaping", Math.Vec2(2.0), TextStyle(
            size:14.0,
            color:Color.orange_500()
        ))
    })
    var updated = recolored.snapshot(160, 32, reuse:previous)
    var updated_layer = updated.text_layers()[0]
    var second_run = updated_layer.glyph_run()
    assert(updated_layer.revision() == previous_layer.revision() + 1)
    assert(updated_layer.shaping_revision() == shaping_revision)
    assert(second_run.glyphs() == first_run.glyphs())
}

test "retain a multiline text block while placement and clipping change" {
    var block = TextBlock(
        "Alpha\nBeta",
        TextStyle(size:14.0, line_height:19.0)
    )
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text_block(
            block,
            Math.Vec2(8.0, 20.0),
            clip:Rect(Math.Vec2(4.0, 8.0), Math.Vec2(100.0, 42.0))
        )
    })
    var previous = first.snapshot(120, 60)
    var previous_layer = previous.text_layers()[0]
    var previous_runs = previous_layer.coverage_runs(2.0)
    assert(previous_layer.block_identity() == block.identity())
    assert(previous_layer.position() == Math.Vec2(8.0, 20.0))
    assert(previous_runs.count() == 2)
    assert(previous_runs[1].origin.y - previous_runs[0].origin.y == 19.0)
    let shaping_revision = previous_layer.shaping_revision()

    var moved = Canvas()
    moved.paint(func(painter:&Painter) {
        painter.text_block(
            block,
            Math.Vec2(8.0, 7.5),
            clip:Rect(Math.Vec2(4.0, 10.0), Math.Vec2(100.0, 38.0))
        )
    })
    var retained = moved.snapshot(120, 60, reuse:previous)
    var retained_layer = retained.text_layers()[0]
    assert(retained_layer.block_identity() == block.identity())
    assert(retained_layer.position() == Math.Vec2(8.0, 7.5))
    assert(retained_layer.shaping_revision() == shaping_revision)
    assert(retained_layer.coverage_runs(2.0).count() == 2)
}

test "retain an unbounded snapshot without inventing a drawing frame" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Origin", Math.Vec2(-12.0, -6.0))
        painter.fill(
            Circle(Math.Vec2(), 8.0),
            Fill.solid(Color.cyan_500())
        )
    })
    var previous = first.snapshot()
    var layers = previous.text_layers()
    assert(layers.count() == 1)
    let text = layers[0].text_layer()
    assert(text.origin == Math.Vec2(-12.0, -6.0))
    assert(text.size.x > 0.0)
    assert(text.size.y > 0.0)

    var changed = Canvas()
    changed.paint(func(painter:&Painter) {
        painter.text("Origin", Math.Vec2(-12.0, -6.0))
        painter.fill(
            Circle(Math.Vec2(), 12.0),
            Fill.solid(Color.cyan_500())
        )
    })
    var retained = changed.snapshot(reuse:previous)
    var retained_layers = retained.text_layers()
    assert(retained.geometry_revision() != previous.geometry_revision())
    assert(retained_layers[0].id() == layers[0].id())
    assert(retained_layers[0].revision() == layers[0].revision())
}

test "do not reuse text coverage across different frames" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.text("Label", Math.Vec2(4.0, 4.0))
    })
    var framed = drawing.snapshot(80, 24)
    assert(framed.text().width() > 0)
    assert(framed.has_cached_text())

    var resized = drawing.snapshot(96, 24, reuse:framed)
    assert(!resized.has_cached_text())
    assert(resized.text_revision() != framed.text_revision())

    var unbounded = drawing.snapshot(reuse:framed)
    assert(!unbounded.has_cached_text())
    let unbounded_text = unbounded.text_layer()
    assert(unbounded_text.origin == Math.Vec2(4.0, 4.0))
}

test "retain prepared geometry while only text changes" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
        painter.text("10%", Math.Vec2(2.0, 2.0))
    })
    var prepared = Prepared()
    drawing.prepare(prepared, 64, 32)
    let geometry_revision = prepared.geometry_revision()
    let revision = prepared.revision()
    var first_layers = prepared.text_layers()
    assert(prepared.geometry().vertex_count() == 6)
    assert(first_layers.count() == 1)

    drawing.clear()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
        painter.text("11%", Math.Vec2(2.0, 2.0))
    })
    drawing.prepare(prepared, 64, 32)
    var changed_layers = prepared.text_layers()
    assert(prepared.revision() != revision)
    assert(prepared.geometry_revision() == geometry_revision)
    assert(changed_layers[0].id() == first_layers[0].id())
    assert(changed_layers[0].revision() == first_layers[0].revision() + 1)
}

test "mutate retained path and text resources without replacing the Canvas" {
    var path = Path()
        ..move_to(Math.Vec2(2.0, 2.0))
        ..line_to(Math.Vec2(18.0, 2.0))
        ..line_to(Math.Vec2(18.0, 12.0))
    var block = TextBlock("phase A", TextStyle(size:14.0))
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.layer([Effect.blur(2.0)], func(layer:&Painter) {
            layer.stroke(path, Stroke(Color.cyan_500(), 2.0))
            layer.text_block(block, Math.Vec2(4.0, 16.0))
        })
    })
    var prepared = drawing.prepared(80, 40)
    let first_drawing_revision = drawing.revision()
    let first_prepared_revision = prepared.revision()
    let first_geometry_revision = prepared.geometry_revision()
    var first_layers = prepared.text_layers()
    let first_text_identity = first_layers[0].id()
    let first_text_revision = first_layers[0].revision()

    path.reset()
        ..move_to(Math.Vec2(6.0, 4.0))
        ..line_to(Math.Vec2(42.0, 4.0))
        ..line_to(Math.Vec2(42.0, 14.0))
    block.replace("phase B")
    var refreshed = drawing.prepared(80, 40)
    var changed_layers = refreshed.text_layers()
    assert(drawing.revision() > first_drawing_revision)
    assert(refreshed.revision() != first_prepared_revision)
    assert(refreshed.revision() == prepared.revision())
    assert(refreshed.geometry_revision() != first_geometry_revision)
    assert(changed_layers[0].id() == first_text_identity)
    assert(changed_layers[0].revision() == first_text_revision + 1)
    if let bounds = drawing.bounds() {
        assert(bounds.size.x > 38.0)
    } else { assert(false) }
}

test "share cached prepared geometry for one authored frame" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var first = drawing.prepared(64, 32)
    var second = drawing.prepared(64, 32)
    let revision = first.revision()
    assert(first.revision() == second.revision())

    drawing.clear()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(16.0)),
            Fill.solid(Color.amber_500())
        )
    })
    var refreshed = drawing.prepared(64, 32)
    assert(refreshed.revision() != revision)
    assert(first.revision() == refreshed.revision())

    var unbounded = drawing.prepared()
    assert(unbounded.revision() != refreshed.revision())
}

test "start aligned retained runs do not scan the global text metric cache" {
    var font = Font.monospace()
    let entries_before = font.cached_metric_count()
    let lookups_before = font.metric_lookup_count()
    let probes_before = font.metric_probe_count()
    var slice_lookups = lookups_before
    var slice_probes = probes_before
    var index = 0
    while index < 640 {
        var block = TextBlock(
            "streamed retained line $(index)",
            TextStyle(size:14.0, font:font, line_height:19.0)
        )
        var drawing = Canvas()
        drawing.paint(func(painter:&Painter) {
            painter.text_block(block, Math.Vec2())
        })
        var snapshot = drawing.snapshot(320, 24)
        var layers = snapshot.text_layers()
        var runs = layers[0].coverage_runs(2.0)
        assert(runs.count() == 1)
        index++
        if index % 128 == 0 {
            print(
                "GFX_CANVAS retained_start depth=$(index) entries=" +
                "$(font.cached_metric_count()) lookups=" +
                "$(font.metric_lookup_count() - slice_lookups) probes=" +
                "$(font.metric_probe_count() - slice_probes)"
            )
            slice_lookups = font.metric_lookup_count()
            slice_probes = font.metric_probe_count()
        }
    }
    let lookup_delta = font.metric_lookup_count() - lookups_before
    let probe_delta = font.metric_probe_count() - probes_before
    print(
        "GFX_CANVAS retained_start entries_before=$(entries_before) " +
        "entries_after=$(font.cached_metric_count()) lookups=$(lookup_delta) " +
        "probes=$(probe_delta)"
    )
    assert(font.cached_metric_count() == entries_before)
    assert(lookup_delta == 0)
    assert(probe_delta == 0)
}

test "bound variable text metrics without linear cache scans" {
    var font = Font.monospace()
    var drawing = Canvas()
    var style = TextStyle(size:14.0, font:font)
    let lookups_before = font.metric_lookup_count()
    let probes_before = font.metric_probe_count()
    var index = 0
    while index < 640 {
        let metrics = drawing.measure_text("diagnostic $(index) office AVATAR", style)
        assert(metrics.width > 0.0)
        index++
    }
    assert(font.cached_metric_count() == 512)
    index = 0
    while index < 100 {
        let metrics = drawing.measure_text("diagnostic 639 office AVATAR", style)
        assert(metrics.width > 0.0)
        index++
    }
    let lookups = font.metric_lookup_count() - lookups_before
    let probes = font.metric_probe_count() - probes_before
    print("GFX_CANVAS metric_cache lookups=$(lookups) probes=$(probes)")
    assert(lookups == 740)
    assert(probes < 4_096)
}

test "align retained coverage and vectors from their prepared runs" {
    var font = Font.monospace()
    let lookups_before = font.metric_lookup_count()
    var block = TextBlock(
        "widest retained line\nshort",
        TextStyle(
            size:14.0,
            font:font,
            alignment:TextAlignment.center,
            line_height:19.0
        )
    )
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.text_block(block, Math.Vec2(160.0, 2.0))
    })
    var snapshot = drawing.snapshot(320, 48)
    var layer = snapshot.text_layers()[0]
    var runs = layer.glyph_runs()
    var width = 0.0
    for retained in runs {
        var run = retained
        width = Math.max(
            width,
            Math.ceil(run.metrics().advance.x) as int as float
        )
    }
    let expected_x = 160.0 - width * 0.5
    var coverage = layer.coverage_runs(2.0)
    assert(coverage.count() == 2)
    assert(coverage[0].origin.x == Math.floor(expected_x * 2.0) / 2.0)
    match layer.vector_outlines() {
        failure(error) => { panic(error.detail) }
        success(placements) => {
            assert(!placements.is_empty())
            assert(placements[0].baseline.x == expected_x)
        }
    }
    assert(font.metric_lookup_count() == lookups_before)
}
