use GFX.Color
use GFX.Canvas.Canvas.Canvas
use GFX.Canvas.Canvas.Painter
use GFX.Canvas.Shapes.Circle
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Styles.Fill
use GFX.Canvas.Styles.Stroke
use STD.Math

test "paint and clear a canvas without SDL or a renderer" {
    var canvas = Canvas()
    canvas.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(20.0, 10.0)),
            Fill.solid(Color.red_500())
        )
        painter.stroke(
            Circle(Math.Vec2(10.0), 4.0),
            Stroke(Color.white(), 2.0)
        )
    })

    var commands = canvas.commands()
    assert(commands.count() == 2)
    assert(canvas.revision() == 3)
    canvas.clear()
    assert(canvas.is_empty())
    assert(canvas.revision() == 4)
}

test "reuse cached text while vector geometry changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(8.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var previous = first.snapshot(160, 40)
    let first_text = previous.text_layer(2.0)
    assert(previous.has_cached_text())

    var changed_geometry = Canvas()
    changed_geometry.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(16.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var reused = changed_geometry.snapshot(160, 40, reuse:previous)
    assert(reused.has_cached_text())
    assert(reused.geometry_revision() != previous.geometry_revision())
    assert(reused.text_revision() == previous.text_revision())

    var changed_text = Canvas()
    changed_text.paint(func(painter:&Painter) {
        painter.text("Changed label", Math.Vec2(4.0, 4.0))
    })
    var invalidated = changed_text.snapshot(160, 40, reuse:reused)
    assert(!invalidated.has_cached_text())
    assert(invalidated.text_revision() != reused.text_revision())
}

test "retain unchanged text layers while one label changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("50%", Math.Vec2(2.0, 20.0))
    })
    var previous = first.snapshot(120, 40)
    var previous_layers = previous.text_layers()
    assert(previous_layers.count() == 2)
    let static_revision = previous_layers[0].revision()
    let value_revision = previous_layers[1].revision()

    var changed = Canvas()
    changed.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("51%", Math.Vec2(2.0, 20.0))
    })
    var retained = changed.snapshot(120, 40, reuse:previous)
    var retained_layers = retained.text_layers()
    assert(retained_layers.count() == 2)
    assert(retained.geometry_revision() == previous.geometry_revision())
    assert(retained_layers[0].id() == previous_layers[0].id())
    assert(retained_layers[0].revision() == static_revision)
    assert(retained_layers[1].id() == previous_layers[1].id())
    assert(retained_layers[1].revision() == value_revision + 1)
}
