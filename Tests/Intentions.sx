use GFX.Color
use GFX.Canvas.Canvas.Canvas
use GFX.Canvas.Canvas.Painter
use GFX.Canvas.Prepared.Prepared
use GFX.Canvas.Shapes.Circle
use GFX.Canvas.Shapes.Rect
use GFX.Canvas.Styles.Fill
use GFX.Canvas.Styles.Stroke
use GFX.Canvas.Styles.TextStyle
use STD.Math

test "paint and clear a canvas without SDL or a renderer" {
    var canvas = Canvas()
    canvas.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(20.0, 10.0)),
            Fill.solid(Color.red_500())
        )
        painter.stroke(
            Circle(Math.Vec2(10.0), 4.0),
            Stroke(Color.white(), 2.0)
        )
    })

    var commands = canvas.commands()
    assert(commands.count() == 2)
    assert(canvas.revision() == 3)
    canvas.clear()
    assert(canvas.is_empty())
    assert(canvas.revision() == 4)
}

test "reuse cached text while vector geometry changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(8.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var previous = first.snapshot(160, 40)
    let first_text = previous.text_layer(2.0)
    assert(previous.has_cached_text())

    var changed_geometry = Canvas()
    changed_geometry.paint(func(painter:&Painter) {
        painter.text("Static label", Math.Vec2(4.0, 4.0))
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(16.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var reused = changed_geometry.snapshot(160, 40, reuse:previous)
    assert(reused.has_cached_text())
    assert(reused.geometry_revision() != previous.geometry_revision())
    assert(reused.text_revision() == previous.text_revision())

    var changed_text = Canvas()
    changed_text.paint(func(painter:&Painter) {
        painter.text("Changed label", Math.Vec2(4.0, 4.0))
    })
    var invalidated = changed_text.snapshot(160, 40, reuse:reused)
    assert(!invalidated.has_cached_text())
    assert(invalidated.text_revision() != reused.text_revision())
}

test "retain unchanged text layers while one label changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("50%", Math.Vec2(2.0, 20.0))
    })
    var previous = first.snapshot(120, 40)
    var previous_layers = previous.text_layers()
    assert(previous_layers.count() == 2)
    let static_revision = previous_layers[0].revision()
    let value_revision = previous_layers[1].revision()

    var changed = Canvas()
    changed.paint(func(painter:&Painter) {
        painter.text("Static", Math.Vec2(2.0, 2.0))
        painter.text("51%", Math.Vec2(2.0, 20.0))
    })
    var retained = changed.snapshot(120, 40, reuse:previous)
    var retained_layers = retained.text_layers()
    assert(retained_layers.count() == 2)
    assert(retained.geometry_revision() == previous.geometry_revision())
    assert(retained_layers[0].id() == previous_layers[0].id())
    assert(retained_layers[0].revision() == static_revision)
    assert(retained_layers[1].id() == previous_layers[1].id())
    assert(retained_layers[1].revision() == value_revision + 1)
}

test "reuse cached line pixels when a retained text list scrolls" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Alpha", Math.Vec2(4.0, 2.0))
        painter.text("Beta", Math.Vec2(4.0, 20.0))
        painter.text("Gamma", Math.Vec2(4.0, 38.0))
    })
    var previous = first.snapshot(120, 60)
    var old_layers = previous.text_layers()
    let old_beta = old_layers[1].text_layer(2.0)
    let old_gamma = old_layers[2].text_layer(2.0)

    var scrolled = Canvas()
    scrolled.paint(func(painter:&Painter) {
        painter.text("Beta", Math.Vec2(4.0, 2.0))
        painter.text("Gamma", Math.Vec2(4.0, 20.0))
        painter.text("Delta", Math.Vec2(4.0, 38.0))
    })
    var reused = scrolled.snapshot(120, 60, reuse:previous)
    var moved_layers = reused.text_layers()
    let moved_beta = moved_layers[0].text_layer(2.0)
    let moved_gamma = moved_layers[1].text_layer(2.0)
    assert(moved_layers[0].id() == old_layers[1].id())
    assert(moved_layers[1].id() == old_layers[2].id())
    assert(moved_beta.image.packed_pixels() == old_beta.image.packed_pixels())
    assert(moved_gamma.image.packed_pixels() == old_gamma.image.packed_pixels())
    assert(moved_beta.origin.y == old_beta.origin.y - 18.0)
    assert(moved_gamma.origin.y == old_gamma.origin.y - 18.0)

    var fresh = scrolled.snapshot(120, 60)
    var fresh_layers = fresh.text_layers()
    let fresh_beta = fresh_layers[0].text_layer(2.0)
    let fresh_gamma = fresh_layers[1].text_layer(2.0)
    assert(moved_beta.image.packed_pixels() == fresh_beta.image.packed_pixels())
    assert(moved_gamma.image.packed_pixels() == fresh_gamma.image.packed_pixels())
    assert(moved_beta.origin == fresh_beta.origin)
    assert(moved_gamma.origin == fresh_gamma.origin)
}

test "reuse shaping when only text color changes" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Stable shaping", Math.Vec2(2.0), TextStyle(
            size:14.0,
            color:Color.cyan_500()
        ))
    })
    var previous = first.snapshot(160, 32)
    var previous_layer = previous.text_layers()[0]
    var first_run = previous_layer.glyph_run()
    let shaping_revision = previous_layer.shaping_revision()

    var recolored = Canvas()
    recolored.paint(func(painter:&Painter) {
        painter.text("Stable shaping", Math.Vec2(2.0), TextStyle(
            size:14.0,
            color:Color.orange_500()
        ))
    })
    var updated = recolored.snapshot(160, 32, reuse:previous)
    var updated_layer = updated.text_layers()[0]
    var second_run = updated_layer.glyph_run()
    assert(updated_layer.revision() == previous_layer.revision() + 1)
    assert(updated_layer.shaping_revision() == shaping_revision)
    assert(second_run.glyphs() == first_run.glyphs())
}

test "retain an unbounded snapshot without inventing a drawing frame" {
    var first = Canvas()
    first.paint(func(painter:&Painter) {
        painter.text("Origin", Math.Vec2(-12.0, -6.0))
        painter.fill(
            Circle(Math.Vec2(), 8.0),
            Fill.solid(Color.cyan_500())
        )
    })
    var previous = first.snapshot()
    var layers = previous.text_layers()
    assert(layers.count() == 1)
    let text = layers[0].text_layer()
    assert(text.origin == Math.Vec2(-12.0, -6.0))
    assert(text.size.x > 0.0)
    assert(text.size.y > 0.0)

    var changed = Canvas()
    changed.paint(func(painter:&Painter) {
        painter.text("Origin", Math.Vec2(-12.0, -6.0))
        painter.fill(
            Circle(Math.Vec2(), 12.0),
            Fill.solid(Color.cyan_500())
        )
    })
    var retained = changed.snapshot(reuse:previous)
    var retained_layers = retained.text_layers()
    assert(retained.geometry_revision() != previous.geometry_revision())
    assert(retained_layers[0].id() == layers[0].id())
    assert(retained_layers[0].revision() == layers[0].revision())
}

test "do not reuse text coverage across different frames" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.text("Label", Math.Vec2(4.0, 4.0))
    })
    var framed = drawing.snapshot(80, 24)
    assert(framed.text().width() > 0)
    assert(framed.has_cached_text())

    var resized = drawing.snapshot(96, 24, reuse:framed)
    assert(!resized.has_cached_text())
    assert(resized.text_revision() != framed.text_revision())

    var unbounded = drawing.snapshot(reuse:framed)
    assert(!unbounded.has_cached_text())
    let unbounded_text = unbounded.text_layer()
    assert(unbounded_text.origin == Math.Vec2(4.0, 4.0))
}

test "retain prepared geometry while only text changes" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
        painter.text("10%", Math.Vec2(2.0, 2.0))
    })
    var prepared = Prepared()
    drawing.prepare(prepared, 64, 32)
    let geometry_revision = prepared.geometry_revision()
    let revision = prepared.revision()
    var first_layers = prepared.text_layers()
    assert(prepared.geometry().vertex_count() == 6)
    assert(first_layers.count() == 1)

    drawing.clear()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
        painter.text("11%", Math.Vec2(2.0, 2.0))
    })
    drawing.prepare(prepared, 64, 32)
    var changed_layers = prepared.text_layers()
    assert(prepared.revision() != revision)
    assert(prepared.geometry_revision() == geometry_revision)
    assert(changed_layers[0].id() == first_layers[0].id())
    assert(changed_layers[0].revision() == first_layers[0].revision() + 1)
}

test "share cached prepared geometry for one authored frame" {
    var drawing = Canvas()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(12.0)),
            Fill.solid(Color.cyan_500())
        )
    })
    var first = drawing.prepared(64, 32)
    var second = drawing.prepared(64, 32)
    let revision = first.revision()
    assert(first.revision() == second.revision())

    drawing.clear()
    drawing.paint(func(painter:&Painter) {
        painter.fill(
            Rect(Math.Vec2(), Math.Vec2(16.0)),
            Fill.solid(Color.amber_500())
        )
    })
    var refreshed = drawing.prepared(64, 32)
    assert(refreshed.revision() != revision)
    assert(first.revision() == refreshed.revision())

    var unbounded = drawing.prepared()
    assert(unbounded.revision() != refreshed.revision())
}
