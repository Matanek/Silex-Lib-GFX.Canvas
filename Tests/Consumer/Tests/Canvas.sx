use GFX.Canvas
use GFX.Assets.Image
use GFX.Color
use GFX.Input
use GFX.Font as VectorFont
use STD.Math

func construct_compatible_fonts(bytes:uint8[], path:str) {
    var encoded = Canvas.Font(bytes)
    var loaded = Canvas.Font(path)
    assert(encoded.face().identity() != "")
    assert(loaded.face().identity() != "")
}

struct ConsumerSession:Canvas.Session {
    func drawing(width:int, height:int) Canvas { return Canvas() }
    func update(delta:float) bool { return false }
    func handle(event:@Input.Event) bool { return false }
    func accepts_text_input() bool { return false }
}

func required_face(result:Result<VectorFont.Face, VectorFont.Error>) VectorFont.Face {
    match result {
        failure(error) => { panic(error.detail) }
        success(face) => { return face }
    }
}

test "consume the public Canvas surface" {
    var monospace = Canvas.Font.monospace()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(16.0), 2.0),
            Canvas.Fill.solid(Color.indigo_500())
        )
        painter.text("Silex", Math.Vec2(1.0), Canvas.TextStyle(size:6.0, font:monospace))
    })

    let image = drawing.rasterize(16, 16)
    assert(drawing.command_count() == 2)
    assert(image.width() == 16)
    assert(image.height() == 16)

    var previous = drawing.snapshot(16, 16)
    let text = previous.text_layer(2.0)
    var layers = previous.text_layers()
    assert(layers.count() == 1)
    let retained_text = layers[0].text_layer(2.0)
    assert(retained_text.image.width() > 0)
    var incremental = drawing.snapshot(16, 16, reuse:previous)
    assert(incremental.text_revision() == previous.text_revision())
    assert(incremental.has_cached_text())

    var unbounded = drawing.snapshot()
    var unbounded_layers = unbounded.text_layers()
    assert(unbounded_layers.count() == 1)
    assert(unbounded_layers[0].text_layer().image.width() > 0)

    var prepared = Canvas.Prepared()
    drawing.prepare(prepared, 16, 16)
    assert(prepared.geometry().vertex_count() == 6)
    var prepared_layers = prepared.text_layers()
    assert(prepared_layers.count() == 1)

    var shared_prepared = drawing.prepared(16, 16)
    var shared_unbounded = drawing.prepared()
    assert(shared_prepared.geometry().vertex_count() == 6)
    assert(shared_unbounded.geometry().vertex_count() == 6)
}

test "consume retained image fills through public Canvas and Assets APIs" {
    var paint = Canvas.ImagePaint(Image.rgba8(2, 1, [
        255, 0, 0, 255,
        0, 0, 255, 255
    ]))
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(8.0, 4.0)),
            Canvas.Fill.image(
                paint,
                Canvas.ImageMapping.fit(
                    frame:Canvas.Rect(Math.Vec2(), Math.Vec2(8.0, 4.0)),
                    mode:Canvas.ImageFit.cover,
                    sampling:Canvas.ImageSampling.smooth
                )
            )
        )
    })
    assert(!drawing.vector_geometry_compatible())
    let raster = drawing.rasterize(8, 4)
    assert(raster.width() == 8)
    var content = drawing.snapshot(8, 4).content()
    match content[0] {
        image(value) => {
            assert(value.geometry().vertex_count() == 6)
            assert(value.paint().revision() == 1)
        }
        else => { assert(false) }
    }
}

test "consume the interactive Canvas session contract" {
    var session = ConsumerSession()
    assert(!session.update(0.016))
    assert(!session.accepts_text_input())
    assert(session.drawing(32, 24).command_count() == 0)
}

test "place grapheme clusters on a fixed text grid" {
    var drawing = Canvas()
    let metrics = drawing.measure_text(
        "terminal",
        Canvas.TextStyle(size:16.0, fixed_advance:10.0)
    )
    assert(metrics.width == 80.0)
    let graphemes = drawing.measure_text(
        "a👩‍🚀b",
        Canvas.TextStyle(size:16.0, fixed_advance:10.0)
    )
    assert(graphemes.width == 30.0)

    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "grid",
            Math.Vec2(1.0),
            Canvas.TextStyle(size:16.0, fixed_advance:10.0),
            clip:Canvas.Rect(Math.Vec2(0.0, 2.0), Math.Vec2(48.0, 18.0))
        )
    })
    let raster = drawing.rasterize(48, 24)
    assert(raster.width() == 48)
    assert(raster.height() == 24)

    var retained = drawing.snapshot(48, 24).text_layers()[0]
    if let clip = retained.clip() {
        assert(clip.position.y == 2.0)
        assert(clip.size.y == 18.0)
    } else { assert(false) }
    let layer = retained.text_layer(2.0)
    assert(layer.size.x == 40.0)
    assert(layer.image.width() == 80)
}

test "retain canonical shaped runs and expose vector outlines" {
    var face = required_face(VectorFont.Face.default())
    var font = Canvas.Font(face)
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "office",
            Math.Vec2(4.0, 3.0),
            Canvas.TextStyle(
                size:18.0,
                color:Color.cyan_400(),
                font:font,
                variations:[VectorFont.Variation("wght", 560.0)]
            )
        )
    })
    var layer = drawing.snapshot(128, 32).text_layers()[0]
    assert(layer.shaping_revision() > 0)
    assert(layer.color() == Color.cyan_400())
    var run = layer.glyph_run()
    assert(run.glyph_count() > 0)
    assert(run.glyph_count() < 6)
    match layer.vector_outlines() {
        failure(error) => { panic(error.detail) }
        success(placements) => {
            assert(placements.count() == run.glyph_count())
            assert(placements[0].baseline.y > 3.0)
        }
    }
    var coverage_runs = layer.coverage_runs(2.0)
    assert(coverage_runs.count() == 1)
    assert(coverage_runs[0].density == 2.0)
    assert(coverage_runs[0].origin.y > 3.0)
    var coverage_run = coverage_runs[0].glyph_run
    assert(coverage_run.glyph_count() == run.glyph_count())

    var grid = Canvas()
    grid.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "a👩‍🚀b",
            Math.Vec2(),
            Canvas.TextStyle(size:16.0, font:font, fixed_advance:10.0)
        )
    })
    var grid_layer = grid.snapshot(48, 24).text_layers()[0]
    var grid_run = grid_layer.glyph_run()
    assert(grid_run.metrics().advance.x == 30.0)
    assert(grid_run.glyphs()[0].origin_x < 10.0)
    assert(grid_run.glyphs()[-1].origin_x >= 20.0)
}

test "compose one shadowed card as ordered public content" {
    var font = Canvas.Font.default()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.layer(
            [Canvas.Effect.shadow(
                offset:Math.Vec2(3.0, 4.0),
                radius:3.0,
                color:Color.black().with_alpha(0.4)
            )],
            func(layer:&Canvas.Painter) {
                layer.fill(
                    Canvas.Rect(Math.Vec2(6.0), Math.Vec2(42.0, 22.0), 3.0),
                    Canvas.Fill.solid(Color.slate_800())
                )
                layer.text(
                    "Projet",
                    Math.Vec2(10.0, 8.0),
                    Canvas.TextStyle(size:12.0, color:Color.white(), font:font)
                )
            }
        )
    })

    var commands = drawing.commands()
    assert(commands.count() == 1)
    match commands[0] {
        layer(group) => {
            assert(group.id() > 0)
            assert(group.revision() == 1)
            assert(group.commands().count() == 2)
            assert(group.effects().count() == 1)
            match group.effects()[0].value() {
                shadow(value) => {
                    assert(value.offset == Math.Vec2(3.0, 4.0))
                    assert(value.radius == 3.0)
                    assert(value.color.a == 0.4)
                }
                else => { assert(false) }
            }
            if let bounds = group.bounds() {
                assert(bounds.position.x <= 6.0)
                assert(bounds.position.y <= 6.0)
                assert(bounds.position.x + bounds.size.x > 48.0)
                assert(bounds.position.y + bounds.size.y > 28.0)
            } else { assert(false) }
        }
        else => { assert(false) }
    }
    assert(!drawing.vector_geometry_compatible())

    var snapshot = drawing.snapshot(64, 40)
    assert(!snapshot.vector_geometry_compatible())
    var content = snapshot.content()
    assert(content.count() == 1)
    match content[0] {
        layer(group) => {
            assert(group.effects().count() == 1)
            var nested = group.content()
            assert(nested.count() == 2)
            match nested[0] { geometry(mesh) => { assert(mesh.vertex_count() > 0) }; else => { assert(false) } }
            match nested[1] { text(value) => { assert(value.glyph_run().glyph_count() > 0) }; else => { assert(false) } }
        }
        else => { assert(false) }
    }

    var prepared = drawing.prepared(64, 40)
    assert(!prepared.vector_geometry_compatible())
    assert(prepared.content().count() == 1)
    var text = snapshot.text_layers()[0]
    var run = text.glyph_run()
    var coverage = text.coverage_runs()
    match text.vector_outlines() {
        failure(error) => { panic(error.detail) }
        success(outlines) => {
            assert(outlines.count() == run.glyph_count())
            assert(coverage[0].glyph_run.glyphs() == run.glyphs())
        }
    }
}
