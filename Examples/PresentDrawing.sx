use GFX.Canvas
use GFX.Color
use GFX.Viewer
use STD.Math

func main() {
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.fill(
            Canvas.Rect(Math.Vec2(), Math.Vec2(640.0, 420.0)),
            Canvas.Fill.solid(Color.slate_50())
        )
        painter.stroke(
            Canvas.Line(Math.Vec2(56.0, 350.0), Math.Vec2(584.0, 70.0)),
            Canvas.Stroke(Color.blue_600(), 4.0)
        )
        painter.text(
            "Retained vector drawing",
            Math.Vec2(56.0, 32.0),
            Canvas.TextStyle(size:22.0, color:Color.slate_900())
        )
    })
    let geometry = drawing.vector_geometry()
    assert(drawing.command_count() == 3)
    assert(geometry.vertex_count() > 0)
    Viewer.show(drawing, Viewer.CanvasSettings(
        width:640,
        height:420,
        title:"GFX.Canvas — Retained drawing"
    ))
}
