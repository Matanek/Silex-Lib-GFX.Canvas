use GFX.Color
use GFX.Canvas
use GFX.Viewer
use STD.Math

func main() {
    var default_font = Canvas.Font.default()
    var monospace_font = Canvas.Font.monospace()
    var drawing = Canvas()
    drawing.paint(func(painter:&Canvas.Painter) {
        painter.text(
            "Default: Silex — déjà prêt",
            Math.Vec2(4.0),
            Canvas.TextStyle(size:18.0, color:Color.white(), font:default_font)
        )
        painter.text(
            "Monospace: imimim",
            Math.Vec2(4.0, 30.0),
            Canvas.TextStyle(size:18.0, color:Color.cyan_300(), font:monospace_font)
        )
    })
    let image = drawing.rasterize(280, 58)
    assert(image.width() == 280)
    assert(image.height() == 58)
    var mono_style = Canvas.TextStyle(size:18.0, font:monospace_font)
    assert(drawing.measure_text("iiii", mono_style).width == drawing.measure_text("mmmm", mono_style).width)
    Viewer.show(image, Viewer.ImageSettings(title:"GFX.Canvas — Text fonts"))
}
